#!/bin/sh

# Mounts the live host share that OpenVMM's virtfs_dir=, virtfs_tag=, and
# virtfs_mode= tokens describe. When virtfs_aggregate=1 marks it as an
# aggregate of host directories and files, its root lists one child per
# directory or file, which only root can enter, and each
# nvx_share=CHILD,TARGET,MODE[,file] token binds one child at TARGET with
# MODE, without set-user-ID programs or device nodes; the file suffix marks a
# child that is a host file, which is bound at a file. With --unmount, the
# binds and then the share are unmounted.

fail() {
    echo "virtfs: $*" >&2
    exit 1
}

vdir=
vtag=
vmode=
aggregate=false
shares=
cmdline=$(cat /proc/cmdline)
# Kernel command-line tokens are deliberately split on spaces.
# shellcheck disable=SC2086
set -f
for token in $cmdline; do
    case "$token" in
        virtfs_dir=*) vdir=${token#*=} ;;
        virtfs_tag=*) vtag=${token#*=} ;;
        virtfs_mode=*) vmode=${token#*=} ;;
        virtfs_aggregate=1) aggregate=true ;;
        nvx_share=*) shares="$shares ${token#*=}" ;;
    esac
done
set +f
[ -n "$vtag" ] || exit 0
[ -n "$vdir" ] || vdir=/mnt/host
[ -n "$vmode" ] || vmode=ro
[ "$aggregate" = true ] || shares=

# Splits the share specification $1 into share_child, share_target,
# share_mode, and share_kind, which is file for a child that is a host file
# and directory otherwise.
parse_share() {
    share_child=${1%%,*}
    share_rest=${1#*,}
    share_kind=directory
    case "$share_rest" in
        *,file)
            share_kind="file"
            share_rest=${share_rest%,file}
            ;;
    esac
    share_target=${share_rest%,*}
    share_mode=${share_rest##*,}
    case "$share_child" in
        '' | . | .. | *[!A-Za-z0-9._-]*) fail "invalid live share $1" ;;
    esac
    case "$share_mode" in ro | rw) ;; *) fail "invalid live share mode in $1" ;; esac
    case "$share_target" in /?*) ;; *) fail "invalid live share target in $1" ;; esac
    [ "$share_rest" != "$1" ] && [ "$share_target" != "$share_rest" ] ||
        fail "invalid live share $1"
}

# Reports whether $1 is a mount point. BusyBox's mountpoint inspects only
# directories, so a bound file is found in the mount table instead.
is_mount_point() {
    if [ -d "$1" ]; then
        mountpoint -q "$1"
    else
        awk -v target="$1" '$2 == target { found = 1 } END { exit !found }' \
            /proc/self/mounts
    fi
}

# Makes $1 a regular file to bind a file child at, creating it and its
# missing directories unless it already is one. A link at $1 is refused
# before anything is created, so that creating the file cannot write
# through the link.
make_file_mount_point() {
    [ ! -L "$1" ] && mkdir -p "${1%/*}/" &&
        { [ -e "$1" ] || : >"$1"; } && [ -f "$1" ]
}

if [ "${1:-}" = --unmount ]; then
    status=0
    reversed=
    set -f
    for share in $shares; do
        reversed="$share $reversed"
    done
    for share in $reversed; do
        set +f
        parse_share "$share"
        if is_mount_point "$share_target" && ! umount "$share_target"; then
            echo "virtfs: failed to unmount live share $share_child at $share_target" >&2
            status=1
        fi
        set -f
    done
    set +f
    if mountpoint -q "$vdir" && ! umount "$vdir"; then
        echo "virtfs: failed to unmount tag $vtag at $vdir" >&2
        status=1
    fi
    exit "$status"
fi

mkdir -p "$vdir"
if ! mount -t virtiofs -o "$vmode" "$vtag" "$vdir" 2>/dev/null; then
    fail "failed to mount tag $vtag at $vdir"
fi
echo "virtfs: mounted live host directory at $vdir (virtiofs,$vmode)"
set -f
for share in $shares; do
    set +f
    parse_share "$share"
    if [ "$share_kind" = file ]; then
        [ -f "$vdir/$share_child" ] || fail "live share $share_child is not an exported file"
        make_file_mount_point "$share_target" ||
            fail "failed to create the file mount point of live share $share_child at $share_target"
    else
        [ -d "$vdir/$share_child" ] || fail "live share $share_child is not exported"
        mkdir -p "$share_target" ||
            fail "failed to create the mount point of live share $share_child at $share_target"
    fi
    if ! mount -o bind "$vdir/$share_child" "$share_target" ||
        ! mount -o "remount,bind,$share_mode,nosuid,nodev" "$share_target"; then
        fail "failed to bind live share $share_child at $share_target"
    fi
    echo "virtfs: bound live share $share_child at $share_target (virtiofs,$share_mode)"
    set -f
done
set +f
