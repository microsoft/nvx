#!/bin/sh
set -eu

export PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME=/root TERM=linux
cmdline=$(cat /proc/cmdline)
runtime=/run/nvx
layers=$runtime/layers
scratch=$runtime/scratch
rootfs=$runtime/rootfs
share_mountpoint=

unmount_live_share() {
    [ -n "$share_mountpoint" ] || return 0
    if ! umount "$share_mountpoint"; then
        echo "NVX-SANDBOX-ERROR: failed to unmount the live share" >&2
        return 1
    fi
    share_mountpoint=
}

fatal() {
    echo "NVX-SANDBOX-ERROR: $*" >&2
    unmount_live_share || true
    /sbin/nvx-exit 125
    while :; do
        sleep 3600
    done
}

cmdline_value() {
    key=$1
    # Kernel command-line tokens are deliberately split on spaces.
    # shellcheck disable=SC2086
    set -f
    for token in $cmdline; do
        case "$token" in
            "$key"=*)
                set +f
                printf '%s\n' "${token#*=}"
                return 0
                ;;
        esac
    done
    set +f
    return 1
}

resolve_block_device() {
    address=$(printf '%d' "$1") || return 1
    attempts=0
    while [ "$attempts" -lt 600 ]; do
        while IFS=' ' read -r range separator platform _; do
            [ "$separator" = : ] || continue
            case "$platform" in virtio-mmio.*) ;; *) continue ;; esac
            start=${range%%-*}
            start=$(printf '%d' "0x$start") || continue
            if [ "$start" -eq "$address" ]; then
                for block in "/sys/devices/virtio-mmio-cmdline/$platform"/virtio*/block/*; do
                    [ -e "$block" ] || continue
                    printf '/dev/%s\n' "${block##*/}"
                    return 0
                done
            fi
        done </proc/iomem
        attempts=$((attempts + 1))
        sleep 0.05
    done
    return 1
}

configure_cgroups() {
    mkdir -p /sys/fs/cgroup
    if ! grep -q ' /sys/fs/cgroup cgroup2 ' /proc/mounts; then
        mount -t cgroup2 -o nosuid,nodev,noexec cgroup2 /sys/fs/cgroup ||
            fatal "failed to mount cgroup2"
    fi

    controllers=
    available=" $(cat /sys/fs/cgroup/cgroup.controllers) "
    case "$available" in *" memory "*) controllers="$controllers +memory" ;; esac
    case "$available" in *" pids "*) controllers="$controllers +pids" ;; esac
    if [ -n "$controllers" ]; then
        echo "$controllers" >/sys/fs/cgroup/cgroup.subtree_control ||
            fatal "failed to enable cgroup controllers"
    fi

    mkdir -p /sys/fs/cgroup/agent /sys/fs/cgroup/container
    echo "$$" >/sys/fs/cgroup/agent/cgroup.procs ||
        fatal "failed to place the agent in its cgroup"

    case "$available" in
        *" memory "*)
            agent_memory_low=$(cmdline_value nvx_agent_memory_low || true)
            [ -n "$agent_memory_low" ] || agent_memory_low=16777216
            echo "$agent_memory_low" >/sys/fs/cgroup/agent/memory.low ||
                fatal "invalid agent memory reservation"
            ;;
    esac
    memory_max=$(cmdline_value nvx_memory_max || true)
    if [ -n "$memory_max" ]; then
        echo "$memory_max" >/sys/fs/cgroup/container/memory.max ||
            fatal "invalid container memory limit"
    fi
    pids_max=$(cmdline_value nvx_pids_max || true)
    if [ -n "$pids_max" ]; then
        echo "$pids_max" >/sys/fs/cgroup/container/pids.max ||
            fatal "invalid container process limit"
    fi
}

mount_layer() {
    role=$1
    address=$2
    expected_uuid=$3
    expected_sectors=$4
    device=$(resolve_block_device "$address") ||
        fatal "$role layer at $address did not appear"
    name=${device##*/}

    if [ -n "$expected_sectors" ]; then
        actual_sectors=$(cat "/sys/class/block/$name/size")
        [ "$actual_sectors" = "$expected_sectors" ] ||
            fatal "$role layer has $actual_sectors sectors, expected $expected_sectors"
    fi

    blockdev --flushbufs "$device" ||
        fatal "failed to drop cached blocks for $role layer"
    directory=$layers/$role
    mkdir -p "$directory"
    mount -t erofs -o ro "$device" "$directory" ||
        fatal "failed to mount $role layer from $device"

    if [ "$expected_uuid" != "-" ]; then
        actual_uuid=$(blkid -s UUID -o value "$device" || true)
        [ "$actual_uuid" = "$expected_uuid" ] ||
            fatal "$role layer UUID is $actual_uuid, expected $expected_uuid"
    fi
}

validate_share_target() {
    case "$1" in
        /*) ;;
        *) fatal "live share target must be an absolute path" ;;
    esac
    case "$1/" in
        //* | *//* | */./* | */../*) fatal "live share target is not canonical: $1" ;;
    esac
    case "$1" in
        *[\\=,]*) fatal "live share target contains a reserved character: $1" ;;
    esac
    # The container runtime mounts or binds these paths after the share, so a
    # share there would be shadowed or would expose host data to runtime writes.
    case "$1" in
        /proc | /proc/* | /sys | /sys/* | /dev | /dev/* | /.nvx-agent | /.nvx-agent/* | /etc)
            fatal "live share target is reserved: $1"
            ;;
    esac
}

mount_live_share() {
    share_tag=$(cmdline_value virtfs_tag || true)
    share_target=$(cmdline_value virtfs_dir || true)
    share_mode=$(cmdline_value virtfs_mode || true)
    [ -n "$share_tag$share_target$share_mode" ] || return 0
    [ -n "$share_tag" ] && [ -n "$share_target" ] && [ -n "$share_mode" ] ||
        fatal "live share bootstrap is incomplete"
    case "$share_tag" in
        *[!A-Za-z0-9_-]*) fatal "live share tag is invalid" ;;
    esac
    case "$share_mode" in
        ro | rw) ;;
        *) fatal "live share mode is unsupported: $share_mode" ;;
    esac
    validate_share_target "$share_target"

    # Create the mount point one component at a time so that a symbolic link in
    # a container layer cannot redirect the share outside the container rootfs.
    share_path=$rootfs
    share_remainder=${share_target#/}
    while [ -n "$share_remainder" ]; do
        share_component=${share_remainder%%/*}
        if [ "$share_component" = "$share_remainder" ]; then
            share_remainder=
        else
            share_remainder=${share_remainder#*/}
        fi
        share_path=$share_path/$share_component
        if [ -L "$share_path" ]; then
            fatal "live share target crosses a symbolic link: $share_target"
        elif [ -e "$share_path" ]; then
            [ -d "$share_path" ] ||
                fatal "live share target is not a directory: $share_target"
        else
            mkdir -m 0755 "$share_path" ||
                fatal "failed to create live share target $share_target"
        fi
    done
    mount -t virtiofs -o "$share_mode,nosuid,nodev" "$share_tag" "$share_path" ||
        fatal "failed to mount live share $share_tag at $share_target"
    share_mountpoint=$share_path
    echo "NVX-SANDBOX-SHARE: target=$share_target mode=$share_mode"
}

# Unmount in dependency order: the live share is a child of the overlay, and
# the overlay uses the layers and scratch.
teardown() {
    status=$1
    rm -f "$runtime/container.pid" "$runtime/workload-machine-id"
    unmount_live_share || status=1
    if ! umount "$rootfs"; then
        echo "NVX-SANDBOX-ERROR: failed to unmount the container overlay" >&2
        status=1
    fi
    for role in custom runtime distro; do
        directory=$layers/$role
        if mountpoint -q "$directory" && ! umount "$directory"; then
            echo "NVX-SANDBOX-ERROR: failed to unmount the $role layer" >&2
            status=1
        fi
    done
    if ! umount "$scratch"; then
        echo "NVX-SANDBOX-ERROR: failed to unmount scratch" >&2
        status=1
    fi
    echo "NVX-SANDBOX-EXIT: status=$status"
    /sbin/nvx-exit "$status"
    while :; do
        sleep 3600
    done
}

mkdir -p "$layers" "$scratch" "$rootfs"
mount -t tmpfs -o mode=755,nosuid,nodev tmpfs /run ||
    fatal "failed to mount runtime tmpfs"
mkdir -p "$layers" "$scratch" "$rootfs"
configure_cgroups

layer_capacity=$(cmdline_value nvx_layer_capacity_sectors || true)
distro=false
runtime_layer=false
custom=false
layer_count=0
# Kernel command-line tokens are deliberately split on spaces.
# shellcheck disable=SC2086
set -f
for token in $cmdline; do
    case "$token" in
        nvx_layer=*)
            specification=${token#*=}
            role=${specification%%,*}
            remainder=${specification#*,}
            [ "$remainder" != "$specification" ] ||
                fatal "layer specification lacks an MMIO address"
            address=${remainder%%,*}
            expected_uuid=${remainder#*,}
            [ "$expected_uuid" != "$remainder" ] ||
                fatal "$role layer specification lacks an EROFS UUID"
            case "$role" in
                distro)
                    [ "$distro" = false ] || fatal "duplicate distro layer"
                    distro=true
                    ;;
                runtime)
                    [ "$runtime_layer" = false ] || fatal "duplicate runtime layer"
                    runtime_layer=true
                    ;;
                custom)
                    [ "$custom" = false ] || fatal "duplicate custom layer"
                    custom=true
                    ;;
                *) fatal "unknown layer role: $role" ;;
            esac
            layer_count=$((layer_count + 1))
            [ "$layer_count" -le 3 ] || fatal "at most three layers are supported"
            set +f
            mount_layer "$role" "$address" "$expected_uuid" "$layer_capacity"
            set -f
            ;;
    esac
done
set +f
[ "$layer_count" -gt 0 ] || fatal "at least one EROFS layer is required"

lowerdirs=
if [ "$distro" = true ]; then
    lowerdirs=$layers/distro
fi
if [ "$runtime_layer" = true ]; then
    lowerdirs=$layers/runtime${lowerdirs:+:$lowerdirs}
fi
if [ "$custom" = true ]; then
    lowerdirs=$layers/custom${lowerdirs:+:$lowerdirs}
fi

scratch_spec=$(cmdline_value nvx_scratch || true)
[ -n "$scratch_spec" ] || fatal "a scratch device is required"
scratch_address=${scratch_spec%%,*}
scratch_fstype=${scratch_spec#*,}
if [ "$scratch_fstype" = "$scratch_spec" ]; then
    scratch_fstype=ext4
fi
[ "$scratch_fstype" = ext4 ] || fatal "unsupported scratch filesystem: $scratch_fstype"
scratch_device=$(resolve_block_device "$scratch_address") ||
    fatal "scratch device at $scratch_address did not appear"
blockdev --flushbufs "$scratch_device" ||
    fatal "failed to drop cached blocks for scratch"
mount -t ext4 -o rw,nosuid,nodev "$scratch_device" "$scratch" ||
    fatal "failed to mount scratch from $scratch_device"
mkdir -p "$scratch/upper" "$scratch/work"

mount -t overlay overlay \
    -o "lowerdir=$lowerdirs,upperdir=$scratch/upper,workdir=$scratch/work,metacopy=on,xino=on" \
    "$rootfs" || fatal "failed to assemble the container overlay"

entrypoint=$(cmdline_value nvx_entrypoint || true)
[ -n "$entrypoint" ] || entrypoint=/bin/sh
case "$entrypoint" in /*) ;; *) fatal "entrypoint must be an absolute path" ;; esac
hostname_value=$(cmdline_value nvx_hostname || true)
[ -n "$hostname_value" ] || hostname_value=nvx-sandbox
workload_uid=$(cmdline_value nvx_workload_uid || true)
workload_gid=$(cmdline_value nvx_workload_gid || true)
case "$workload_uid" in '' | 0 | *[!0-9]*) fatal "workload UID is unavailable" ;; esac
case "$workload_gid" in '' | 0 | *[!0-9]*) fatal "workload GID is unavailable" ;; esac
[ -f "$rootfs/etc/passwd" ] && [ ! -L "$rootfs/etc/passwd" ] ||
    fatal "workload user database is unavailable"
[ -f "$rootfs/etc/group" ] && [ ! -L "$rootfs/etc/group" ] ||
    fatal "workload group database is unavailable"
workload_record=$(
    awk -F: -v uid="$workload_uid" '
        $3 == uid { count++; record = $1 ":" $3 ":" $4 ":" $6 }
        END { if (count == 1) print record; else exit 1 }
    ' "$rootfs/etc/passwd"
) || fatal "configured workload UID is unavailable"
workload_name=${workload_record%%:*}
workload_remainder=${workload_record#*:}
resolved_uid=${workload_remainder%%:*}
workload_remainder=${workload_remainder#*:}
resolved_gid=${workload_remainder%%:*}
workload_home=${workload_remainder#*:}
[ -n "$workload_name" ] && [ "$workload_home" != "$workload_remainder" ] ||
    fatal "configured workload user record is invalid"
[ "$resolved_uid" = "$workload_uid" ] && [ "$resolved_gid" = "$workload_gid" ] ||
    fatal "configured workload identity does not match the user database"
awk -F: -v gid="$workload_gid" '$3 == gid { found = 1 } END { exit !found }' \
    "$rootfs/etc/group" || fatal "configured workload GID is unavailable"
case "$workload_home" in /*) ;; *) fatal "configured workload home is invalid" ;; esac
[ -d "$rootfs$workload_home" ] && [ ! -L "$rootfs$workload_home" ] ||
    fatal "configured workload home is unavailable"

workload_lifecycle=$(cmdline_value nvx_lifecycle || true)
[ -n "$workload_lifecycle" ] || workload_lifecycle=one-shot
case "$workload_lifecycle" in
    one-shot) ;;
    managed)
        control_tty=$(cmdline_value nvx_control_tty || true)
        [ "$control_tty" = hvc2 ] ||
            fatal "managed lifecycle requires the dedicated control tty"
        ;;
    *) fatal "unsupported workload lifecycle: $workload_lifecycle" ;;
esac

mount_live_share
workload_machine_id=$(tr -d - </proc/sys/kernel/random/uuid)
printf '%s\n' "$workload_machine_id" >"$runtime/workload-machine-id"

if [ "$workload_lifecycle" = managed ]; then
    echo "NVX-SANDBOX-READY: managed layers=$layer_count"
    # The agent returns after a stop request, so managed sandboxes share the
    # one-shot teardown instead of powering off with their mounts in place.
    status=0
    /sbin/nvx-managed-agent \
        "/dev/$control_tty" "$rootfs" "$hostname_value" \
        "$workload_uid" "$workload_gid" "$workload_name" "$workload_home" ||
        status=$?
    teardown "$status"
fi

set -- "$entrypoint"
# Kernel command-line tokens are deliberately split on spaces.
# shellcheck disable=SC2086
set -f
for token in $cmdline; do
    case "$token" in
        nvx_arg=*) set -- "$@" "${token#*=}" ;;
    esac
done
set +f

barrier=$runtime/container-start
mkfifo "$barrier"
/sbin/nvx-container-launch \
    "$barrier" "$rootfs" "$hostname_value" \
    "$workload_uid" "$workload_gid" "$workload_name" "$workload_home" "$@" &
container_pid=$!
if ! echo "$container_pid" >/sys/fs/cgroup/container/cgroup.procs; then
    kill "$container_pid" 2>/dev/null || true
    wait "$container_pid" 2>/dev/null || true
    fatal "failed to place the workload in its cgroup"
fi
printf '%s\n' "$container_pid" >"$runtime/container.pid"
printf 'start\n' >"$barrier"
rm -f "$barrier"

echo "NVX-SANDBOX-READY: pid=$container_pid layers=$layer_count"
status=0
wait "$container_pid" || status=$?
teardown "$status"
