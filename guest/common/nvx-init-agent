#!/bin/sh
set -eu

export PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME=/root TERM=linux
cmdline=$(cat /proc/cmdline)
runtime=/run/nvx
layers=$runtime/layers
scratch=$runtime/scratch
# The mount point of a RAM upper, which nvx::guest::root names alike.
tmpfs=$runtime/tmpfs
rootfs=$runtime/rootfs
# The host export of a managed sandbox goes at $hostfs/root, where only root
# can enter, as in the guest's plain path.
hostfs=$runtime/hostfs
# Mounted live shares, or the host export of a managed sandbox, one per line
# and most recent first, so that teardown unmounts them in reverse mount order.
share_mountpoints=

unmount_live_shares() {
    unmount_status=0
    unmount_ifs=$IFS
    IFS='
'
    set -f
    for share_mountpoint in $share_mountpoints; do
        if ! umount "$share_mountpoint"; then
            echo "NVX-SANDBOX-ERROR: failed to unmount the live share at ${share_mountpoint#"$rootfs"}" >&2
            unmount_status=1
        fi
    done
    set +f
    IFS=$unmount_ifs
    share_mountpoints=
    return "$unmount_status"
}

fatal() {
    echo "NVX-SANDBOX-ERROR: $*" >&2
    unmount_live_shares || true
    /sbin/nvx-exit 125
    while :; do
        sleep 3600
    done
}

cmdline_value() {
    key=$1
    # Kernel command-line tokens are deliberately split on spaces.
    # shellcheck disable=SC2086
    set -f
    for token in $cmdline; do
        case "$token" in
            "$key"=*)
                set +f
                printf '%s\n' "${token#*=}"
                return 0
                ;;
        esac
    done
    set +f
    return 1
}

resolve_block_device() {
    address=$(printf '%d' "$1") || return 1
    attempts=0
    while [ "$attempts" -lt 600 ]; do
        while IFS=' ' read -r range separator platform _; do
            [ "$separator" = : ] || continue
            case "$platform" in virtio-mmio.*) ;; *) continue ;; esac
            start=${range%%-*}
            start=$(printf '%d' "0x$start") || continue
            if [ "$start" -eq "$address" ]; then
                for block in "/sys/devices/virtio-mmio-cmdline/$platform"/virtio*/block/*; do
                    [ -e "$block" ] || continue
                    printf '/dev/%s\n' "${block##*/}"
                    return 0
                done
            fi
        done </proc/iomem
        attempts=$((attempts + 1))
        sleep 0.05
    done
    return 1
}

configure_cgroups() {
    mkdir -p /sys/fs/cgroup
    if ! grep -q ' /sys/fs/cgroup cgroup2 ' /proc/mounts; then
        mount -t cgroup2 -o nosuid,nodev,noexec cgroup2 /sys/fs/cgroup ||
            fatal "failed to mount cgroup2"
    fi

    controllers=
    available=" $(cat /sys/fs/cgroup/cgroup.controllers) "
    case "$available" in *" memory "*) controllers="$controllers +memory" ;; esac
    case "$available" in *" pids "*) controllers="$controllers +pids" ;; esac
    if [ -n "$controllers" ]; then
        echo "$controllers" >/sys/fs/cgroup/cgroup.subtree_control ||
            fatal "failed to enable cgroup controllers"
    fi

    mkdir -p /sys/fs/cgroup/agent /sys/fs/cgroup/container
    echo "$$" >/sys/fs/cgroup/agent/cgroup.procs ||
        fatal "failed to place the agent in its cgroup"

    case "$available" in
        *" memory "*)
            agent_memory_low=$(cmdline_value nvx_agent_memory_low || true)
            [ -n "$agent_memory_low" ] || agent_memory_low=16777216
            echo "$agent_memory_low" >/sys/fs/cgroup/agent/memory.low ||
                fatal "invalid agent memory reservation"
            ;;
    esac
    memory_max=$(cmdline_value nvx_memory_max || true)
    if [ -n "$memory_max" ]; then
        echo "$memory_max" >/sys/fs/cgroup/container/memory.max ||
            fatal "invalid container memory limit"
    fi
    pids_max=$(cmdline_value nvx_pids_max || true)
    if [ -n "$pids_max" ]; then
        echo "$pids_max" >/sys/fs/cgroup/container/pids.max ||
            fatal "invalid container process limit"
    fi
}

# The host's process limit, which configure_cgroups applies, holds one more
# process than the workload's for the one-shot launcher's `unshare` parent.
# A managed execution has no such parent, so the container cgroup gives that
# process back.
give_back_launcher_process() {
    case "$pids_max" in
        '' | *[!0-9]*) ;;
        *)
            echo "$((pids_max - 1))" >/sys/fs/cgroup/container/pids.max ||
                fatal "invalid container process limit"
            ;;
    esac
}

mount_layer() {
    role=$1
    address=$2
    expected_uuid=$3
    expected_sectors=$4
    device=$(resolve_block_device "$address") ||
        fatal "$role layer at $address did not appear"
    name=${device##*/}

    if [ -n "$expected_sectors" ]; then
        actual_sectors=$(cat "/sys/class/block/$name/size")
        [ "$actual_sectors" = "$expected_sectors" ] ||
            fatal "$role layer has $actual_sectors sectors, expected $expected_sectors"
    fi

    blockdev --flushbufs "$device" ||
        fatal "failed to drop cached blocks for $role layer"
    directory=$layers/$role
    mkdir -p "$directory"
    mount -t erofs -o ro "$device" "$directory" ||
        fatal "failed to mount $role layer from $device"

    if [ -n "$expected_uuid" ]; then
        actual_uuid=$(blkid -s UUID -o value "$device" || true)
        [ "$actual_uuid" = "$expected_uuid" ] ||
            fatal "$role layer UUID is $actual_uuid, expected $expected_uuid"
    fi
}

# Returns whether $1 is a UUID in its canonical text: 32 lowercase hexadecimal
# digits in groups of 8, 4, 4, 4, and 12, joined by hyphens.
is_canonical_uuid() {
    case "$1" in
        # The shape fixes four hyphens, so a fifth would stand for a digit.
        *[!0-9a-f-]* | *-*-*-*-*-*) return 1 ;;
        ????????-????-????-????-????????????) return 0 ;;
    esac
    return 1
}

# Reads the value of the nvx_layer token for read_root_tokens:
# distro,0xd0003000,FORMAT[:IDENTITY], where this init accepts only the erofs
# format, with or without the filesystem UUID that the image must have.
read_layer_token() {
    layer_image=${1#distro,0xd0003000,}
    case "$1" in
        distro,0xd0003000,*,*) ;;
        distro,0xd0003000,erofs)
            layer_uuid=
            return 0
            ;;
        distro,0xd0003000,erofs:*)
            layer_uuid=${layer_image#erofs:}
            is_canonical_uuid "$layer_uuid" ||
                fatal "the nvx_layer kernel parameter names an invalid EROFS filesystem UUID: '$layer_uuid'"
            return 0
            ;;
        distro,0xd0003000,gpt | distro,0xd0003000,gpt:*)
            fatal "nvx_layer=$1 names a GPT image, which this init cannot assemble: it assembles only an EROFS image"
            ;;
        distro,0xd0003000,*)
            layer_format=${layer_image%%:*}
            # The form without a format names the UUID in its place.
            if [ -z "$layer_format" ] || is_canonical_uuid "$layer_format"; then
                fatal "the nvx_layer kernel parameter names no image format, erofs or gpt: '$1'"
            fi
            fatal "the nvx_layer kernel parameter names the unsupported image format '$layer_format'"
            ;;
    esac
    fatal "the nvx_layer kernel parameter must be distro,0xd0003000,FORMAT[:IDENTITY], not '$1'"
}

# Reads the boot tokens of the layered root, with the rules of the host's
# renderer, nvx::protocol::root: nvx_layer names the image of the distro block
# device, and nvx_scratch=0xd0006000,ext4 or nvx_overlay_upper=ramfs the upper,
# each once. This init assembles only an EROFS image, so it also refuses a GPT
# image. Sets layer_uuid to the filesystem UUID that the image must have, or to
# nothing if the token names none, and upper to scratch or ram. The parser also
# refuses a RAM upper beside a scratch block device, which this init checks
# against the kernel's devices instead, with refuse_scratch_device. The tests
# replay nvx-rs/tests/fixtures/root-tokens.json through it.
read_root_tokens() {
    layer_seen=false
    scratch_seen=false
    ram_seen=false
    layer_uuid=
    # Kernel command-line tokens are deliberately split on spaces.
    # shellcheck disable=SC2086
    set -f
    for token in $cmdline; do
        case "$token" in
            nvx_layer | nvx_scratch | nvx_overlay_upper)
                fatal "the $token kernel parameter has no value"
                ;;
            nvx_layer=*)
                [ "$layer_seen" = false ] ||
                    fatal "the nvx_layer kernel parameter is repeated"
                layer_seen=true
                read_layer_token "${token#*=}"
                ;;
            nvx_scratch=*)
                [ "$scratch_seen" = false ] ||
                    fatal "the nvx_scratch kernel parameter is repeated"
                scratch_seen=true
                [ "${token#*=}" = 0xd0006000,ext4 ] ||
                    fatal "the nvx_scratch kernel parameter must be 0xd0006000,ext4, not '${token#*=}'"
                ;;
            nvx_overlay_upper=*)
                [ "$ram_seen" = false ] ||
                    fatal "the nvx_overlay_upper kernel parameter is repeated"
                ram_seen=true
                [ "${token#*=}" = ramfs ] ||
                    fatal "the nvx_overlay_upper kernel parameter must be ramfs, not '${token#*=}'"
                ;;
        esac
    done
    set +f
    [ "$scratch_seen" = false ] || [ "$ram_seen" = false ] ||
        fatal "a layered root has one upper, but the command line names both nvx_scratch and nvx_overlay_upper"
    [ "$layer_seen" = true ] ||
        fatal "the command line names no distro layer: this init needs nvx_layer=distro,0xd0003000,erofs[:UUID]"
    if [ "$scratch_seen" = true ]; then
        upper=scratch
    elif [ "$ram_seen" = true ]; then
        upper=ram
    else
        fatal "the nvx_layer kernel parameter needs an upper, nvx_scratch or nvx_overlay_upper"
    fi
}

# Fails if the kernel has a virtio-mmio device at the scratch block device's
# MMIO base, 0xd0006000, which a RAM upper must not have. nvx::protocol::root
# reads the devices from the virtio_mmio.device= parameters of the command
# line, with the kernel's rules; this init asks the kernel instead, which lists
# the window of each device that it added in /proc/iomem, where
# resolve_block_device finds them too.
refuse_scratch_device() {
    scratch_address=$(printf '%d' 0xd0006000)
    while IFS=' ' read -r range separator platform _; do
        [ "$separator" = : ] || continue
        case "$platform" in virtio-mmio.*) ;; *) continue ;; esac
        start=$(printf '%d' "0x${range%%-*}") || continue
        [ "$start" -ne "$scratch_address" ] ||
            fatal "a RAM upper takes no scratch block device, but the kernel has a virtio-mmio device at 0xd0006000"
    done </proc/iomem
}

# Mounts the upper that read_root_tokens read, and creates the overlay's upper
# and work directories on it: the ext4 scratch disk at 0xd0006000, or a tmpfs,
# with the mode of an ext4 scratch's root rather than tmpfs's world-writable
# default, and with the kernel's default size, half of the guest's RAM, as
# nvx::guest::root mounts them. Sets upper_point to the upper's mount point,
# and upper_name to what messages call it. A tmpfs upper's pages are charged to
# the memory cgroup of the process that writes them, so the workload's writes
# count against its nvx_memory_max.
mount_upper() {
    case "$upper" in
        scratch)
            upper_point=$scratch
            upper_name=scratch
            mkdir -p "$upper_point"
            scratch_device=$(resolve_block_device 0xd0006000) ||
                fatal "scratch device at 0xd0006000 did not appear"
            blockdev --flushbufs "$scratch_device" ||
                fatal "failed to drop cached blocks for scratch"
            mount -t ext4 -o rw,nosuid,nodev "$scratch_device" "$upper_point" ||
                fatal "failed to mount scratch from $scratch_device"
            ;;
        ram)
            upper_point=$tmpfs
            upper_name="the tmpfs upper"
            mkdir -p "$upper_point"
            mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs "$upper_point" ||
                fatal "failed to mount the tmpfs upper"
            ;;
    esac
    mkdir -p "$upper_point/upper" "$upper_point/work"
}

validate_share_target() {
    case "$1" in
        /*) ;;
        *) fatal "live share target must be an absolute path" ;;
    esac
    case "$1/" in
        //* | *//* | */./* | */../*) fatal "live share target is not canonical: $1" ;;
    esac
    # nvx::protocol::share::RESERVED_TARGET_CHARACTERS lists the same
    # characters: Linux reads a double quote as a quote, which could make it
    # read the rest of the command line as part of the target's token.
    case "$1" in
        *[\\=,\"]*) fatal "live share target contains a reserved character: $1" ;;
    esac
    # The container runtime mounts or binds these paths after the share, so a
    # share there would be shadowed or would expose host data to runtime writes.
    # It also creates /run and /run/nvx, and binds its time state over /run/nvx/time.
    case "$1" in
        /proc | /proc/* | /sys | /sys/* | /dev | /dev/* | /.nvx-agent | /.nvx-agent/* | /etc | /etc/machine-id | /etc/machine-id/* | /run | /run/nvx | /run/nvx/time | /run/nvx/time/*)
            fatal "live share target is reserved: $1"
            ;;
    esac
}

# Creates the mount point of the live share target $1 inside the container
# rootfs one component at a time, so that a symbolic link in a container layer
# cannot redirect the share outside that rootfs, and sets share_path to it.
# With $2 set to file, the last component is a regular file, for a share that
# binds a host file, and every other component a directory.
make_share_mount_point() {
    share_path=$rootfs
    share_remainder=${1#/}
    while [ -n "$share_remainder" ]; do
        share_component=${share_remainder%%/*}
        if [ "$share_component" = "$share_remainder" ]; then
            share_remainder=
        else
            share_remainder=${share_remainder#*/}
        fi
        share_path=$share_path/$share_component
        if [ -L "$share_path" ]; then
            fatal "live share target crosses a symbolic link: $1"
        elif [ -z "$share_remainder" ] && [ "${2:-directory}" = file ]; then
            if [ -e "$share_path" ]; then
                [ -f "$share_path" ] ||
                    fatal "live share target is not a regular file: $1"
            else
                (umask 022 && : >"$share_path") ||
                    fatal "failed to create live share target $1"
            fi
        elif [ -e "$share_path" ]; then
            [ -d "$share_path" ] ||
                fatal "live share target is not a directory: $1"
        else
            mkdir -m 0755 "$share_path" ||
                fatal "failed to create live share target $1"
        fi
    done
}

# Records a mounted live share for teardown, most recent first.
record_live_share() {
    share_mountpoints="$1${share_mountpoints:+
$share_mountpoints}"
}

# Checks that the live share target $1 is valid and that no other share hides
# or shadows it.
claim_share_target() {
    validate_share_target "$1"
    set -f
    for mounted_target in $share_targets; do
        case "$1/" in
            "$mounted_target"/*)
                set +f
                fatal "live share targets overlap: $mounted_target and $1"
                ;;
        esac
        case "$mounted_target/" in
            "$1"/*)
                set +f
                fatal "live share targets overlap: $mounted_target and $1"
                ;;
        esac
    done
    set +f
    share_targets="$share_targets $1"
}

mount_live_share() {
    share_tag=$1
    share_target=$2
    share_mode=$3
    case "$share_tag" in
        '' | *[!A-Za-z0-9_-]*) fatal "live share tag is invalid" ;;
    esac
    case "$share_mode" in
        ro | rw) ;;
        *) fatal "live share mode is unsupported: $share_mode" ;;
    esac
    claim_share_target "$share_target"
    make_share_mount_point "$share_target"
    mount -t virtiofs -o "$share_mode,nosuid,nodev" "$share_tag" "$share_path" ||
        fatal "failed to mount live share $share_tag at $share_target"
    record_live_share "$share_path"
    echo "NVX-SANDBOX-SHARE: target=$share_target mode=$share_mode tag=$share_tag"
}

# Splits the aggregate child specification $1, CHILD,TARGET,MODE[,file], into
# child_name, child_target, child_mode, and child_kind, which is file for a
# child that is a host file and directory otherwise.
parse_share_child() {
    child_name=${1%%,*}
    child_rest=${1#*,}
    child_kind=directory
    case "$child_rest" in
        *,file)
            child_kind="file"
            child_rest=${child_rest%,file}
            ;;
    esac
    child_target=${child_rest%,*}
    child_mode=${child_rest##*,}
    if [ "$child_rest" = "$1" ] || [ "$child_target" = "$child_rest" ]; then
        fatal "live share child is invalid: $1"
    fi
    case "$child_name" in
        '' | . | .. | *[!A-Za-z0-9._-]*) fatal "live share child is invalid: $1" ;;
    esac
    case "$child_mode" in
        ro | rw) ;;
        *) fatal "live share mode is unsupported: $child_mode" ;;
    esac
}

# Binds child $2 of the aggregate share mounted at $1 at the target $3 inside
# the container rootfs, with mode $4 and without set-user-ID programs or
# device nodes. The child is a directory, or a host file when $5 is file, and
# the kernel refuses to bind either at a mount point of the other kind.
bind_live_share() {
    make_share_mount_point "$3" "$5"
    mount -o bind "$1/$2" "$share_path" ||
        fatal "failed to bind live share $2 at $3"
    record_live_share "$share_path"
    mount -o "remount,bind,$4,nosuid,nodev" "$share_path" ||
        fatal "failed to restrict live share $2 at $3"
    echo "NVX-SANDBOX-SHARE: target=$3 mode=$4 child=$2"
}

mount_live_shares() {
    # OpenVMM appends one virtfs_dir=, virtfs_tag=, virtfs_mode= triplet for
    # its virtio-fs share, and virtfs_aggregate=1 when that share is an
    # aggregate of host directories and files, which
    # nvx_share=CHILD,TARGET,MODE[,file] tokens place. Parse every token
    # before mounting anything, so that a malformed bootstrap mounts nothing.
    share_dir=
    share_tag=
    share_mode=
    share_fields=0
    share_aggregate=false
    share_children=
    # Kernel command-line tokens are deliberately split on spaces.
    # shellcheck disable=SC2086
    set -f
    for token in $cmdline; do
        case "$token" in
            virtfs_dir=?*)
                share_dir=${token#*=}
                share_fields=$((share_fields + 1))
                ;;
            virtfs_tag=?*)
                share_tag=${token#*=}
                share_fields=$((share_fields + 1))
                ;;
            virtfs_mode=?*)
                share_mode=${token#*=}
                share_fields=$((share_fields + 1))
                ;;
            virtfs_dir=* | virtfs_tag=* | virtfs_mode=*)
                set +f
                fatal "live share bootstrap is incomplete"
                ;;
            virtfs_aggregate=1) share_aggregate=true ;;
            nvx_share=*) share_children="$share_children ${token#*=}" ;;
        esac
    done
    set +f
    if [ "$share_fields" -eq 0 ] && [ "$share_aggregate" = false ] &&
        [ -z "$share_children" ]; then
        return 0
    fi
    [ "$share_fields" -eq 3 ] && [ -n "$share_dir" ] && [ -n "$share_tag" ] &&
        [ -n "$share_mode" ] || fatal "live share bootstrap is incomplete"
    share_targets=
    if [ "$share_aggregate" = false ]; then
        [ -z "$share_children" ] ||
            fatal "live share children require an aggregate share"
        mount_live_share "$share_tag" "$share_dir" "$share_mode"
        return 0
    fi
    # The aggregate's root lists every child, so it stays outside the
    # container rootfs, where only this agent reaches it.
    [ "$share_dir" = "$runtime/shares" ] ||
        fatal "the aggregate live share must be mounted at $runtime/shares"
    case "$share_tag" in
        '' | *[!A-Za-z0-9_-]*) fatal "live share tag is invalid" ;;
    esac
    case "$share_mode" in
        ro | rw) ;;
        *) fatal "live share mode is unsupported: $share_mode" ;;
    esac
    [ -n "$share_children" ] || fatal "the aggregate live share has no children"
    share_seen=
    set -f
    for share_spec in $share_children; do
        set +f
        parse_share_child "$share_spec"
        case " $share_seen " in
            *" $child_name "*) fatal "live share child is not unique: $child_name" ;;
        esac
        share_seen="$share_seen $child_name"
        claim_share_target "$child_target"
        make_share_mount_point "$child_target" "$child_kind"
        set -f
    done
    set +f
    mkdir -p "$share_dir" ||
        fatal "failed to create the aggregate live share directory"
    mount -t virtiofs -o "$share_mode,nosuid,nodev" "$share_tag" "$share_dir" ||
        fatal "failed to mount the aggregate live share $share_tag"
    record_live_share "$share_dir"
    set -f
    for share_spec in $share_children; do
        set +f
        parse_share_child "$share_spec"
        bind_live_share "$share_dir" "$child_name" "$child_target" "$child_mode" \
            "$child_kind"
        set -f
    done
    set +f
}

# Mounts the host's virtio-fs export of a managed sandbox, from which its
# guest agent maps host paths into the container rootfs as the mapping table
# that the host sends once the control session is ready orders them. OpenVMM
# appends one virtfs_dir=, virtfs_tag=, virtfs_mode= triplet and
# virtfs_aggregate=1 for the export, whose root lists one child per host
# directory or file. It goes at $hostfs/root, where only root can enter, so
# that a workload reaches host paths only through their mappings. The agent
# reads the nvx_maps= count itself, and nvx_share= tokens, which place the
# children of a one-shot sandbox, are refused. Every token is checked before
# anything is mounted.
mount_host_export() {
    export_dir=
    export_tag=
    export_mode=
    export_fields=0
    export_aggregate=false
    # Kernel command-line tokens are deliberately split on spaces.
    # shellcheck disable=SC2086
    set -f
    for token in $cmdline; do
        case "$token" in
            virtfs_dir=?*)
                export_dir=${token#*=}
                export_fields=$((export_fields + 1))
                ;;
            virtfs_tag=?*)
                export_tag=${token#*=}
                export_fields=$((export_fields + 1))
                ;;
            virtfs_mode=?*)
                export_mode=${token#*=}
                export_fields=$((export_fields + 1))
                ;;
            virtfs_dir=* | virtfs_tag=* | virtfs_mode=*)
                set +f
                fatal "host export bootstrap is incomplete"
                ;;
            virtfs_aggregate=1) export_aggregate=true ;;
            nvx_share=*)
                set +f
                fatal "a managed sandbox maps its live shares from the host's mapping table, not from nvx_share= tokens"
                ;;
        esac
    done
    set +f
    if [ "$export_fields" -eq 0 ] && [ "$export_aggregate" = false ]; then
        return 0
    fi
    [ "$export_fields" -eq 3 ] && [ "$export_aggregate" = true ] ||
        fatal "host export bootstrap is incomplete"
    [ "$export_dir" = "$hostfs/root" ] ||
        fatal "the host export must be mounted at $hostfs/root"
    case "$export_tag" in
        '' | *[!A-Za-z0-9_-]*) fatal "host export tag is invalid" ;;
    esac
    case "$export_mode" in
        ro | rw) ;;
        *) fatal "host export mode is unsupported: $export_mode" ;;
    esac
    if ! (umask 077 && mkdir "$hostfs") || ! mkdir "$export_dir"; then
        fatal "failed to create the host export directory"
    fi
    mount -t virtiofs -o "$export_mode,nosuid,nodev" "$export_tag" "$export_dir" ||
        fatal "failed to mount the host export $export_tag"
    record_live_share "$export_dir"
    echo "NVX-SANDBOX-EXPORT: mode=$export_mode tag=$export_tag"
}

# Unmount in dependency order: the live shares are children of the overlay, as
# are the mappings that a managed sandbox's agent unmounts in its own mount
# namespace before it returns, and the overlay uses the layers and the upper.
teardown() {
    status=$1
    rm -f "$runtime/container.pid" "$runtime/workload-machine-id"
    unmount_live_shares || status=1
    if ! umount "$rootfs"; then
        echo "NVX-SANDBOX-ERROR: failed to unmount the container overlay" >&2
        status=1
    fi
    directory=$layers/distro
    if mountpoint -q "$directory" && ! umount "$directory"; then
        echo "NVX-SANDBOX-ERROR: failed to unmount the distro layer" >&2
        status=1
    fi
    if ! umount "$upper_point"; then
        echo "NVX-SANDBOX-ERROR: failed to unmount $upper_name" >&2
        status=1
    fi
    echo "NVX-SANDBOX-EXIT: status=$status"
    /sbin/nvx-exit "$status"
    while :; do
        sleep 3600
    done
}

mkdir -p "$layers" "$rootfs"
# init mounts /run before the time ABI boot check, whose state lives there.
mountpoint -q /run || mount -t tmpfs -o mode=755,nosuid,nodev tmpfs /run ||
    fatal "failed to mount runtime tmpfs"
mkdir -p "$layers" "$rootfs"
configure_cgroups

layer_capacity=$(cmdline_value nvx_layer_capacity_sectors || true)
read_root_tokens
# A RAM upper is refused beside a scratch block device before anything mounts.
[ "$upper" = scratch ] || refuse_scratch_device
mount_layer distro 0xd0003000 "$layer_uuid" "$layer_capacity"
layer_count=1

lowerdirs=$layers/distro

mount_upper

mount -t overlay overlay \
    -o "lowerdir=$lowerdirs,upperdir=$upper_point/upper,workdir=$upper_point/work,metacopy=on,xino=on" \
    "$rootfs" || fatal "failed to assemble the container overlay"

entrypoint=$(cmdline_value nvx_entrypoint || true)
[ -n "$entrypoint" ] || entrypoint=/bin/sh
case "$entrypoint" in /*) ;; *) fatal "entrypoint must be an absolute path" ;; esac
hostname_value=$(cmdline_value nvx_hostname || true)
[ -n "$hostname_value" ] || hostname_value=nvx-sandbox
workload_uid=$(cmdline_value nvx_workload_uid || true)
workload_gid=$(cmdline_value nvx_workload_gid || true)
case "$workload_uid" in '' | 0 | *[!0-9]*) fatal "workload UID is unavailable" ;; esac
case "$workload_gid" in '' | 0 | *[!0-9]*) fatal "workload GID is unavailable" ;; esac
[ -f "$rootfs/etc/passwd" ] && [ ! -L "$rootfs/etc/passwd" ] ||
    fatal "workload user database is unavailable"
[ -f "$rootfs/etc/group" ] && [ ! -L "$rootfs/etc/group" ] ||
    fatal "workload group database is unavailable"
workload_record=$(
    awk -F: -v uid="$workload_uid" '
        $3 == uid { count++; record = $1 ":" $3 ":" $4 ":" $6 }
        END { if (count == 1) print record; else exit 1 }
    ' "$rootfs/etc/passwd"
) || fatal "configured workload UID is unavailable"
workload_name=${workload_record%%:*}
workload_remainder=${workload_record#*:}
resolved_uid=${workload_remainder%%:*}
workload_remainder=${workload_remainder#*:}
resolved_gid=${workload_remainder%%:*}
workload_home=${workload_remainder#*:}
[ -n "$workload_name" ] && [ "$workload_home" != "$workload_remainder" ] ||
    fatal "configured workload user record is invalid"
[ "$resolved_uid" = "$workload_uid" ] && [ "$resolved_gid" = "$workload_gid" ] ||
    fatal "configured workload identity does not match the user database"
awk -F: -v gid="$workload_gid" '$3 == gid { found = 1 } END { exit !found }' \
    "$rootfs/etc/group" || fatal "configured workload GID is unavailable"
case "$workload_home" in /*) ;; *) fatal "configured workload home is invalid" ;; esac
[ -d "$rootfs$workload_home" ] && [ ! -L "$rootfs$workload_home" ] ||
    fatal "configured workload home is unavailable"

workload_lifecycle=$(cmdline_value nvx_lifecycle || true)
[ -n "$workload_lifecycle" ] || workload_lifecycle=one-shot
case "$workload_lifecycle" in
    one-shot) ;;
    managed)
        control_tty=$(cmdline_value nvx_control_tty || true)
        [ "$control_tty" = hvc2 ] ||
            fatal "managed lifecycle requires the dedicated control tty"
        ;;
    *) fatal "unsupported workload lifecycle: $workload_lifecycle" ;;
esac

# A one-shot sandbox binds its live shares now, as their boot tokens place
# them, and a managed sandbox's agent maps them from the host export once the
# host sends their mapping table.
case "$workload_lifecycle" in
    managed) mount_host_export ;;
    *) mount_live_shares ;;
esac

if [ "$workload_lifecycle" = managed ]; then
    # The managed agent enters each execution itself, as the first process of
    # its own PID namespace, and generates the workload's machine ID.
    give_back_launcher_process
    echo "NVX-SANDBOX-READY: managed layers=$layer_count"
    # The agent returns after a stop request, so managed sandboxes share the
    # one-shot teardown instead of powering off with their mounts in place.
    status=0
    /sbin/nvx-managed-agent \
        "/dev/$control_tty" "$rootfs" "$hostname_value" \
        "$workload_uid" "$workload_gid" "$workload_name" "$workload_home" ||
        status=$?
    teardown "$status"
fi

workload_machine_id=$(tr -d - </proc/sys/kernel/random/uuid)
printf '%s\n' "$workload_machine_id" >"$runtime/workload-machine-id"

set -- "$entrypoint"
# Kernel command-line tokens are deliberately split on spaces.
# shellcheck disable=SC2086
set -f
for token in $cmdline; do
    case "$token" in
        nvx_arg=*) set -- "$@" "${token#*=}" ;;
    esac
done
set +f

barrier=$runtime/container-start
mkfifo "$barrier"
/sbin/nvx-container-launch \
    "$barrier" "$rootfs" "$hostname_value" \
    "$workload_uid" "$workload_gid" "$workload_name" "$workload_home" "$@" &
container_pid=$!
if ! echo "$container_pid" >/sys/fs/cgroup/container/cgroup.procs; then
    kill "$container_pid" 2>/dev/null || true
    wait "$container_pid" 2>/dev/null || true
    fatal "failed to place the workload in its cgroup"
fi
printf '%s\n' "$container_pid" >"$runtime/container.pid"
printf 'start\n' >"$barrier"
rm -f "$barrier"

echo "NVX-SANDBOX-READY: pid=$container_pid layers=$layer_count"
status=0
wait "$container_pid" || status=$?
teardown "$status"
