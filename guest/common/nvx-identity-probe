#!/bin/sh
set -eu

uid=$(id -u)
gid=$(id -g)
[ "$uid" -ne 0 ] && [ "$gid" -ne 0 ] || exit 80
if touch /etc/nvx-identity-probe >/dev/null 2>&1; then
    rm -f /etc/nvx-identity-probe
    exit 81
fi
if setpriv --reuid 0 --regid 0 --clear-groups true 2>/dev/null; then
    exit 82
fi
echo "NVX-WORKLOAD-IDENTITY-OK uid=$uid gid=$gid"
