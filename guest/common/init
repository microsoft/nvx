#!/bin/sh
# PID 1 for an NVX RAM initramfs. Mounts the pseudo-filesystems, prints a
# recognizable boot-completion banner, and drops to an interactive shell.
# Accept an existing mount only when it has the requested filesystem type.
# These mounts precede devtmpfs, so a failed boot may have no /dev/port yet.
mount_pseudo() {
    mount -t "$1" none "$2" 2>/dev/null ||
        [ "$(stat -f -c %T "$2" 2>/dev/null)" = "$1" ] || {
        echo "NVX-INIT-ERROR: cannot mount $1 on $2" >&2
        [ -c /dev/port ] || /bin/busybox mknod -m 600 /dev/port c 1 4
        /sbin/nvx-exit 1
        while :; do
            sleep 3600
        done
    }
}
mount_pseudo proc /proc
mount_pseudo sysfs /sys
mount -t devtmpfs none /dev 2>/dev/null || mdev -s
# The kernel supports modules only so that STRICT_MODULE_RWX keeps runtime
# code, such as the ITS mitigation thunks, read-only. No module is shipped, so
# loading is switched off for good before any other process runs.
if [ -e /proc/sys/kernel/modules_disabled ] &&
    ! echo 1 >/proc/sys/kernel/modules_disabled; then
    echo "NVX-INIT-ERROR: cannot disable kernel module loading" >&2
    /sbin/nvx-exit 1
    while :; do
        sleep 3600
    done
fi
# The time ABI boot step runs next, before any other guest work, in every
# guest mode: the initial clock step only. The other boot checks then run in
# the background and start the time daemon; a failure powers the VM off, and
# the state and daemon live under /run/nvx/time, so /run is mounted first and
# kept.
mount -t tmpfs -o mode=755,nosuid,nodev tmpfs /run
if ! /sbin/nvx-time boot; then
    /sbin/nvx-exit 193
    while :; do
        sleep 3600
    done
fi
mount -t tmpfs none /tmp
export PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME=/root TERM=linux
ifconfig lo 127.0.0.1 up
cmdline=" $(cat /proc/cmdline) "
case "$cmdline" in
    *" nvx_sandbox=1 "*) sandbox_mode=true ;;
    *) sandbox_mode=false ;;
esac
new_init=false
if [ "$sandbox_mode" = true ]; then
    case "$cmdline" in
        *" nvx_lifecycle="*) ;;
        *) new_init=true ;;
    esac
fi

fatal() {
    echo "$*" >&2
    /bin/busybox reboot -f
    exit 1
}
workload_fatal() {
    echo "NVX-WORKLOAD-ERROR: $*" >&2
    /sbin/nvx-exit 125
    while :; do
        sleep 3600
    done
}
# Succeeds if $1 is a decimal ID other than root's: zero is root's however many
# digits spell it, as setpriv and the user database read them as numbers.
nonroot_id() {
    case "$1" in
        '' | *[!0-9]*) return 1 ;;
        *[!0]*) return 0 ;;
    esac
    return 1
}
resolve_workload_identity() {
    nonroot_id "$workload_uid" || workload_fatal "workload UID is unavailable"
    nonroot_id "$workload_gid" || workload_fatal "workload GID is unavailable"
    workload_record=$(
        awk -F: -v uid="$workload_uid" '
            $3 == uid { count++; record = $1 ":" $3 ":" $4 ":" $6 }
            END { if (count == 1) print record; else exit 1 }
        ' /etc/passwd
    ) || workload_fatal "configured workload UID is unavailable"
    workload_name=${workload_record%%:*}
    workload_remainder=${workload_record#*:}
    resolved_uid=${workload_remainder%%:*}
    workload_remainder=${workload_remainder#*:}
    resolved_gid=${workload_remainder%%:*}
    workload_home=${workload_remainder#*:}
    [ -n "$workload_name" ] && [ "$workload_home" != "$workload_remainder" ] ||
        workload_fatal "configured workload user record is invalid"
    [ "$resolved_uid" = "$workload_uid" ] &&
        [ "$resolved_gid" = "$workload_gid" ] ||
        workload_fatal "configured workload identity does not match the user database"
    awk -F: -v gid="$workload_gid" \
        '$3 == gid { found = 1 } END { exit !found }' /etc/group ||
        workload_fatal "configured workload GID is unavailable"
    case "$workload_home" in
        /*) ;;
        *) workload_fatal "configured workload home is invalid" ;;
    esac
    [ -d "$workload_home" ] && [ ! -L "$workload_home" ] ||
        workload_fatal "configured workload home is unavailable"
}
# Gives a non-root workload identity an account that resolves, for the launches
# that ask for one with nvx_workload_account=create: managed workloads that map
# host files under the host user's own IDs, and the CLI's. An image account that
# already uses the UID with another primary group or an unusable home is
# replaced, since workloads run under the numeric IDs either way.
ensure_workload_account() {
    # An identity that resolve_workload_identity refuses gets no account, so
    # that a zero ID cannot replace root's record.
    if ! nonroot_id "$workload_uid" || ! nonroot_id "$workload_gid"; then
        return 0
    fi
    if ! awk -F: -v gid="$workload_gid" '$3 == gid { found = 1 } END { exit !found }' \
        /etc/group; then
        printf 'nvx:x:%s:\n' "$workload_gid" >>/etc/group ||
            workload_fatal "failed to create the workload group"
    fi
    # Keep an image account that already resolves; a failed resolution only
    # ends this subshell.
    if (
        workload_fatal() { exit 1; }
        resolve_workload_identity
    ); then
        return 0
    fi
    if awk -F: -v uid="$workload_uid" '$3 != uid' /etc/passwd >/etc/passwd.nvx &&
        printf 'nvx:x:%s:%s:NVX workload:/tmp:/sbin/nologin\n' \
            "$workload_uid" "$workload_gid" >>/etc/passwd.nvx &&
        mv -f /etc/passwd.nvx /etc/passwd; then
        return 0
    fi
    workload_fatal "failed to create the workload account"
}
# Runs a one-shot workload, the program and arguments given, once as the
# workload identity, without privileges, and powers the VM off with its status.
run_workload() {
    resolve_workload_identity
    status=0
    HOME="$workload_home" USER="$workload_name" LOGNAME="$workload_name" \
        setpriv \
        --reuid "$workload_uid" \
        --regid "$workload_gid" \
        --clear-groups \
        --no-new-privs \
        --bounding-set=-all \
        --inh-caps=-all \
        --ambient-caps=-all \
        "$@" || status=$?
    /sbin/nvx-exit "$status"
    while :; do
        sleep 3600
    done
}
# Reads the workload identity of nvx_identity=UID:GID. Both IDs must be given:
# without them, an nvx_exec workload would skip run_workload and run as root.
read_workload_identity() {
    workload_uid=${1%%:*}
    workload_gid=${1#*:}
    if [ "$1" != "$workload_uid:$workload_gid" ] ||
        [ -z "$workload_uid" ] || [ -z "$workload_gid" ]; then
        workload_fatal "nvx_identity must be UID:GID"
    fi
}
nvx_exec=
nvx_exec_seen=false
workload_uid=
workload_gid=
workload_lifecycle=one-shot
control_tty=
workload_account=
entrypoint=
entrypoints=0
# Kernel command-line tokens are deliberately split on spaces. OpenVMM's
# options give the lifecycle and the workload identity tokens of their own; a
# blockless launch of the CLI gives the CLI's instead, nvx_mode=one-shot or
# nvx_mode=managed and nvx_identity=UID:GID, and names its one-shot workload
# with nvx_entrypoint= and nvx_arg= tokens, whose values become the positional
# parameters, in order.
# shellcheck disable=SC2086
set -f
set --
for token in $cmdline; do
    case "$token" in
        nvx_exec=*)
            [ "$nvx_exec_seen" = false ] || fatal "nvx_exec may be specified only once"
            nvx_exec_seen=true
            nvx_exec=${token#*=}
            [ -n "$nvx_exec" ] || fatal "nvx_exec must not be empty"
            ;;
        nvx_workload_uid=*) workload_uid=${token#*=} ;;
        nvx_workload_gid=*) workload_gid=${token#*=} ;;
        nvx_identity=*) read_workload_identity "${token#*=}" ;;
        nvx_lifecycle=* | nvx_mode=*) workload_lifecycle=${token#*=} ;;
        nvx_entrypoint=*)
            entrypoint=${token#*=}
            entrypoints=$((entrypoints + 1))
            ;;
        nvx_arg=*) set -- "$@" "${token#*=}" ;;
        nvx_control_tty=*) control_tty=${token#*=} ;;
        nvx_workload_account=*) workload_account=${token#*=} ;;
    esac
done
set +f
if [ -n "$nvx_exec" ] && [ "$new_init" = false ]; then
    case "$nvx_exec" in
        /*) ;;
        *) fatal "nvx_exec must be an absolute initramfs path" ;;
    esac
    if [ -n "$workload_uid$workload_gid" ]; then
        run_workload "$nvx_exec"
    fi
    exec "$nvx_exec"
fi
mount_virtfs() {
    /sbin/nvx-hostmount || fatal "virtfs: failed to mount live host directory"
}
if [ "$sandbox_mode" = false ]; then
    mount_virtfs
fi
# virt-net: if --net attached a NIC, configure the only non-loopback interface.
announcer_pid=
nip=$(sed -n 's/.*virtnet_ip=\([^ ]*\).*/\1/p' /proc/cmdline)
if [ -n "$nip" ]; then
    nmask=$(sed -n 's/.*virtnet_mask=\([^ ]*\).*/\1/p' /proc/cmdline)
    ngw=$(sed -n 's/.*virtnet_gw=\([^ ]*\).*/\1/p' /proc/cmdline)
    ndns=$(sed -n 's/.*virtnet_dns=\([^ ]*\).*/\1/p' /proc/cmdline)
    nip6=$(sed -n 's/.*virtnet_ip6=\([^ ]*\).*/\1/p' /proc/cmdline)
    ngw6=$(sed -n 's/.*virtnet_gw6=\([^ ]*\).*/\1/p' /proc/cmdline)
    virtnet_error() {
        echo "virtnet: $*" >&2
    }

    ndev=
    tries=0
    while [ "$tries" -lt 600 ] && [ -z "$ndev" ]; do
        for npath in /sys/class/net/*; do
            [ -e "$npath" ] || continue
            candidate=${npath##*/}
            [ "$candidate" = lo ] && continue
            ndev=$candidate
            break
        done
        [ -n "$ndev" ] || sleep 0.05
        tries=$((tries + 1))
    done
    if [ -z "$ndev" ]; then
        virtnet_error "no network interface found after 30s"
    else
        [ -n "$nmask" ] || nmask=255.255.255.0
        if [ -n "$nip6" ]; then
            # Besides the kernel's link-local address, the static identity is
            # the link's only IPv6 configuration: the interface neither
            # solicits routers nor autoconfigures addresses from their
            # advertisements, and needs no duplicate address detection on its
            # private link.
            for nsetting in accept_ra autoconf accept_dad; do
                if ! echo 0 >"/proc/sys/net/ipv6/conf/$ndev/$nsetting"; then
                    virtnet_error "failed to disable IPv6 $nsetting on $ndev"
                fi
            done
        fi
        if ! ifconfig "$ndev" "$nip" netmask "$nmask" up; then
            virtnet_error "failed to configure $ndev as $nip/$nmask"
        fi
        if [ -n "$ngw" ]; then
            route del default dev "$ndev" 2>/dev/null
            route add -host "$ngw" dev "$ndev" 2>/dev/null
            if ! route add default gw "$ngw" dev "$ndev"; then
                virtnet_error "failed to install standalone default route via $ngw"
            fi
        fi
        if [ -n "$nip6" ]; then
            if ! busybox ip -6 addr add "$nip6" dev "$ndev"; then
                virtnet_error "failed to configure $ndev as $nip6"
            elif [ -n "$ngw6" ] &&
                ! busybox ip -6 route add default via "$ngw6" dev "$ndev"; then
                virtnet_error "failed to install IPv6 default route via $ngw6"
            fi
        fi

        if [ -n "$ndns" ]; then
            if ! : >/etc/resolv.conf; then
                virtnet_error "failed to replace /etc/resolv.conf"
            fi
            oldifs=$IFS
            IFS=,
            for server in $ndns; do
                if [ -n "$server" ]; then
                    if ! printf 'nameserver %s\n' "$server" >>/etc/resolv.conf; then
                        virtnet_error "failed to write DNS server $server"
                    fi
                fi
            done
            IFS=$oldifs
        fi

        # With private-network or host-loopback ingress, the gateway learns
        # the workload's listeners from nvx-ingress and publishes them on the
        # host: to its private networks, or on host loopback alone.
        ningress=$(sed -n 's/.*virtnet_ingress=\([^ ]*\).*/\1/p' /proc/cmdline)
        case "$ningress" in
            allow | host-loopback)
                if [ -n "$ngw" ] && [ -x /sbin/nvx-ingress ]; then
                    /sbin/nvx-ingress "$ngw" </dev/null &
                    announcer_pid=$!
                else
                    virtnet_error "$ningress ingress needs /sbin/nvx-ingress and an IPv4 gateway"
                fi
                ;;
        esac

        nprobe=$(sed -n 's/.*virtnet_probe=\([^ ]*\).*/\1/p' /proc/cmdline)
        if [ -n "$nprobe" ]; then
            if ping -c 1 -W 1 "$nprobe" >/tmp/virtnet-probe.log 2>&1; then
                echo "VIRTNET-PROBE-OK: $nprobe"
            else
                cat /tmp/virtnet-probe.log >&2
                echo "VIRTNET-PROBE-FAIL: $nprobe" >&2
            fi
        fi
        echo "VIRTNET-OK: configured $ndev as $nip/$nmask"
    fi
fi
if [ "$sandbox_mode" = true ]; then
    if [ "$new_init" = false ]; then
        [ -x /sbin/nvx-init-agent ] ||
            workload_fatal "selected guest cannot act as sandbox control"
        exec /sbin/nvx-init-agent
    fi
    [ -x /sbin/nvx-init ] ||
        workload_fatal "selected guest cannot act as sandbox control"
    # nvx-time boot returns before its child publishes the daemon PID.
    tries=0
    while [ ! -r /run/nvx/time/daemon.pid ] && [ "$tries" -lt 600 ]; do
        sleep 0.05
        tries=$((tries + 1))
    done
    time_daemon=$(cat /run/nvx/time/daemon.pid) ||
        workload_fatal "time daemon process ID is unavailable"
    set -- "$time_daemon"
    [ -z "$announcer_pid" ] || set -- "$@" "$announcer_pid"
    exec /sbin/nvx-init "$@"
fi
case "$workload_lifecycle" in
    one-shot)
        # A one-shot workload runs once, after the shares and the network,
        # and ends the VM; without one, the interactive shell below starts.
        if [ "$entrypoints" -gt 0 ]; then
            [ "$entrypoints" -eq 1 ] ||
                workload_fatal "nvx_entrypoint may be specified only once"
            case "$entrypoint" in
                /*) ;;
                *) workload_fatal "nvx_entrypoint must be an absolute path" ;;
            esac
            if [ "$workload_account" = create ]; then
                ensure_workload_account
            fi
            run_workload "$entrypoint" "$@"
        fi
        ;;
    managed)
        if [ "$workload_account" = create ]; then
            ensure_workload_account
        fi
        resolve_workload_identity
        [ "$control_tty" = hvc2 ] ||
            workload_fatal "managed lifecycle requires the dedicated control tty"
        exec /sbin/nvx-managed-agent \
            "/dev/$control_tty" - nvx-managed \
            "$workload_uid" "$workload_gid" "$workload_name" "$workload_home"
        ;;
    *) workload_fatal "unsupported workload lifecycle" ;;
esac
# netsnap: optional snapshot self-test/benchmark for --net (see `scripts/nvx.py bench-net-snapshot`).
# When the kernel command line contains "netsnap", check the link, then ask the VMM to take a
# snapshot through /sbin/nvx-snapshot. On the snapshot run the VMM captures here
# and exits; on a later restore, execution resumes at the next line -- so the guest re-checks the
# link (now over the freshly rebuilt backend) and prints a marker the benchmark greps for.
#
# The check is a single sysfs read of the NIC's carrier, deliberately lighter than fork/exec-ing
# `ping`: the benchmark only needs to confirm the link resumed, and the ~60 ms of ping process
# startup would otherwise dominate the restore-to-marker time (round-trips over the link are
# sub-millisecond). The `link_up` function is defined before the snapshot point, so it is part of
# the captured shell state and is still available when execution resumes on restore.
case " $(cat /proc/cmdline) " in
    *" netsnap "*)
        linkdev="${ndev:-eth0}"
        link_up() { read -r c 2>/dev/null <"/sys/class/net/$linkdev/carrier" && [ "$c" = 1 ]; }
        link_up && echo "netsnap: pre-snapshot link OK" || echo "netsnap: pre-snapshot link FAIL"
        ntcp=$(sed -n 's/.*netsnap_tcp=\([^ ]*\).*/\1/p' /proc/cmdline)
        if [ -n "$ntcp" ]; then
            nthost=${ntcp%:*}
            ntport=${ntcp##*:}
            rm -f /tmp/netsnap-tcp.in /tmp/netsnap-tcp.out
            : >/tmp/netsnap-tcp.in
            follow_tcp_input() {
                next_line=1
                while :; do
                    line=$(sed -n "${next_line}p" /tmp/netsnap-tcp.in)
                    if [ -n "$line" ]; then
                        printf '%s\n' "$line"
                        next_line=$((next_line + 1))
                    else
                        sleep 0.05
                    fi
                done
            }
            follow_tcp_input |
                nc "$nthost" "$ntport" >/tmp/netsnap-tcp.out 2>&1 &
            ncpid=$!
            wait_for_tcp_ack() {
                marker=$1
                attempts=0
                while [ "$attempts" -lt 5 ]; do
                    grep -q "^ACK:$marker$" /tmp/netsnap-tcp.out && return 0
                    kill -0 "$ncpid" 2>/dev/null || return 1
                    attempts=$((attempts + 1))
                    sleep 1
                done
                return 1
            }
            echo PRE >>/tmp/netsnap-tcp.in
            if wait_for_tcp_ack PRE; then
                echo "netsnap: pre-snapshot TCP OK ($ntcp)"
            else
                echo "netsnap: pre-snapshot TCP FAIL ($ntcp)" >&2
            fi
        fi
        ntxflood=$(sed -n 's/.*netsnap_tx_flood=\([^ ]*\).*/\1/p' /proc/cmdline)
        if [ -n "$ntxflood" ]; then
            ping -i 0.01 "$ntxflood" >/tmp/netsnap-tx-flood.log 2>&1 &
            ntxpid=$!
            sleep 1
            if kill -0 "$ntxpid" 2>/dev/null; then
                echo "netsnap: active TX flood running ($ntxflood)"
            else
                cat /tmp/netsnap-tx-flood.log >&2
                echo "netsnap: active TX flood failed ($ntxflood)" >&2
                ntxpid=
            fi
        fi
        /sbin/nvx-snapshot
        # ---- on restore, execution resumes here ----
        if link_up; then
            if [ -n "$nprobe" ]; then
                if ping -c 1 -W 1 "$nprobe" >/tmp/netsnap-restore-probe.log 2>&1; then
                    echo "NETSNAP-RESTORE-PROBE-OK: $nprobe"
                    echo "NETSNAP-RESTORE-OK"
                else
                    cat /tmp/netsnap-restore-probe.log >&2
                    echo "NETSNAP-RESTORE-PROBE-FAIL: $nprobe" >&2
                    echo "NETSNAP-RESTORE-FAIL"
                fi
            else
                echo "NETSNAP-RESTORE-OK"
            fi
        else
            echo "NETSNAP-RESTORE-FAIL"
        fi
        if [ -n "$ntxpid" ]; then
            kill "$ntxpid" 2>/dev/null
            wait "$ntxpid" 2>/dev/null
            echo "NETSNAP-ACTIVE-TX-RESTORE-OK: $ntxflood"
        fi
        if [ -n "$ntcp" ]; then
            echo POST >>/tmp/netsnap-tcp.in
            if wait_for_tcp_ack POST; then
                echo "NETSNAP-TCP-RESTORE-OK: $ntcp"
            else
                cat /tmp/netsnap-tcp.out >&2
                echo "NETSNAP-TCP-RESTORE-FAIL: $ntcp" >&2
            fi
            wait "$ncpid" 2>/dev/null
        fi
        ;;
esac
# shellsnap: optional pre-banner snapshot hook for the restore-vCPU diagnostic.
# When the kernel command line contains "shellsnap", ask the VMM to take a snapshot
# through /sbin/nvx-snapshot just before the boot banner below.
# On the snapshot run the VMM captures here and exits; on a later restore, execution resumes at the
# next line and falls through to the banner -- the same marker the benchmark times on a cold boot.
# On a plain cold boot (no --snapshot) the VMM ignores the write, so this stays a no-op.
case " $(cat /proc/cmdline) " in
    *" shellsnap "*)
        /sbin/nvx-snapshot
        # ---- on restore, execution resumes here ----
        ;;
esac
echo
echo "=========================================="
guest_id=$(sed -n 's/^ID=//p' /etc/os-release 2>/dev/null | tr -d '"')
case "$guest_id" in
    alpine)
        echo " ALPINE-MICROVM-BOOT-OK: $(cat /etc/alpine-release 2>/dev/null)"
        ;;
    ubuntu) ;;
    azurelinux) ;;
    *) fatal "unsupported guest identity: ${guest_id:-missing}" ;;
esac
echo " uname: $(uname -a)"
echo "=========================================="
echo
case "$guest_id" in
    alpine | azurelinux) echo "NVX-GUEST-BOOT-OK: $guest_id" ;;
esac
restore_probe=$(sed -n 's/.*nvx_virtio_restore_probe=\([^ ]*\).*/\1/p' /proc/cmdline)
if [ -n "$restore_probe" ]; then
    case "$restore_probe" in
        *,*) ;;
        *) fatal "nvx_virtio_restore_probe must be DEVICE,MODE" ;;
    esac
    restore_device=${restore_probe%%,*}
    restore_mode=${restore_probe#*,}
    case "$restore_mode" in
        *,*) fatal "nvx_virtio_restore_probe has too many fields" ;;
    esac
    exec /sbin/nvx-virtio-restore-probe \
        --device "$restore_device" --mode "$restore_mode"
fi
# snap: optional snapshot benchmark for a plain (non-networked) shell (see the shell-snapshot
# benchmark). When the kernel command line contains "snap", ask the VMM to take a snapshot at
# this fully-booted, shell-ready point through /sbin/nvx-snapshot. On the
# snapshot run the VMM captures here and exits; on a later restore, execution resumes at the next
# line and the guest prints a marker the benchmark greps for before dropping to the shell.
case " $(cat /proc/cmdline) " in
    *" snap "*)
        /sbin/nvx-snapshot
        # ---- on restore, execution resumes here ----
        echo "SNAP-RESTORE-OK"
        ;;
esac
if [ "$guest_id" = ubuntu ]; then
    exec /bin/bash --noprofile --rcfile /etc/nvx-bashrc -i
fi
exec /bin/sh
