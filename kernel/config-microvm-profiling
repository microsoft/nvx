# Profiling overlay for the micro-VM kernel.
#
# Merge this fragment on top of kernel/config-microvm to build a vmlinux whose stacks can be walked
# via the frame-pointer chain, which is what the nvx guest profiler follows. The default config
# uses the ORC unwinder and omits frame pointers, so guest stacks would otherwise be shallow.
#
# Applied by `python3 scripts/nvx.py build-kernel --profiling` using the official merge helper:
#   ./scripts/kconfig/merge_config.sh -m .config kernel/config-microvm-profiling && make olddefconfig
#
# Enable frame-pointer unwinding and disable ORC.
CONFIG_UNWINDER_FRAME_POINTER=y
# CONFIG_UNWINDER_ORC is not set
# Force frame pointers everywhere, including the scheduler hot paths, for complete stacks.
CONFIG_FRAME_POINTER=y
# CONFIG_SCHED_OMIT_FRAME_POINTER is not set
