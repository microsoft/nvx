From: NVX maintainers
Subject: [PATCH] virtio: mmio: add OpenVMM microVM shared interrupt status

The OpenVMM microVM ABI reserves a shared interrupt-status page. Discover it
through PVH E820 on x86 and per-device DT properties on arm64.

--- a/drivers/virtio/Kconfig
+++ b/drivers/virtio/Kconfig
@@ -171,6 +171,19 @@
 
 	 If unsure, say 'N'.
 
+config VIRTIO_MMIO_SHARED_STATUS
+	bool "OpenVMM microVM shared virtio-mmio interrupt status"
+	depends on VIRTIO_MMIO && (X86 || ARM64)
+	help
+	  Use the interrupt-status page defined by OpenVMM microVM ABI version 2.
+	  The page is discovered through the Xen PVH E820 map on x86 or through
+	  each virtio-mmio device-tree node on arm64. It has one atomic status word
+	  for every fixed transport slot. Interrupt handlers exchange their word to
+	  zero instead of reading and acknowledging the virtio-mmio registers.
+
+	  This option is specific to kernels built for the OpenVMM microVM ABI.
+	  If unsure, say N.
+
 config VIRTIO_DMA_SHARED_BUFFER
 	tristate
 	depends on DMA_SHARED_BUFFER
--- a/drivers/virtio/virtio_mmio.c
+++ b/drivers/virtio/virtio_mmio.c
@@ -70,6 +70,13 @@
 #include <uapi/linux/virtio_mmio.h>
 #include <linux/virtio_ring.h>
 
+#if defined(CONFIG_VIRTIO_MMIO_SHARED_STATUS) && defined(CONFIG_X86)
+#include <asm/e820/api.h>
+#endif
+#if defined(CONFIG_VIRTIO_MMIO_SHARED_STATUS) && defined(CONFIG_ARM64)
+#include <linux/of.h>
+#endif
+
 
 
 /* The alignment to use between consumer and producer parts of vring.
@@ -87,8 +94,96 @@
 
 	void __iomem *base;
 	unsigned long version;
+#ifdef CONFIG_VIRTIO_MMIO_SHARED_STATUS
+	u32 *shared_status;
+#endif
 };
 
+#ifdef CONFIG_VIRTIO_MMIO_SHARED_STATUS
+#define MICROVM_SHARED_STATUS_PAGE_GPA	0x30000
+#define MICROVM_SHARED_STATUS_PAGE_SIZE	0x1000
+#ifdef CONFIG_X86
+static bool microvm_shared_status_available;
+#endif
+
+#define MICROVM_VIRTIO_NET_MMIO_BASE	0xd0000000
+#define MICROVM_VIRTIO_FS_MMIO_BASE	0xd0001000
+#define MICROVM_VIRTIO_CONSOLE_MMIO_BASE	0xd0002000
+#define MICROVM_VIRTIO_DISTRO_BLK_MMIO_BASE	0xd0003000
+#define MICROVM_VIRTIO_RUNTIME_BLK_MMIO_BASE	0xd0004000
+#define MICROVM_VIRTIO_CUSTOM_BLK_MMIO_BASE	0xd0005000
+#define MICROVM_VIRTIO_SCRATCH_BLK_MMIO_BASE	0xd0006000
+
+static int vm_setup_shared_status(struct virtio_mmio_device *vm_dev)
+{
+	struct platform_device *pdev = vm_dev->pdev;
+	struct resource *resource;
+	phys_addr_t status_gpa;
+#ifdef CONFIG_X86
+	u64 offset;
+
+	if (!microvm_shared_status_available)
+		return 0;
+#endif
+
+	resource = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!resource)
+		return -EINVAL;
+
+#ifdef CONFIG_X86
+	switch (resource->start) {
+	case MICROVM_VIRTIO_NET_MMIO_BASE:
+		offset = 0x00;
+		break;
+	case MICROVM_VIRTIO_FS_MMIO_BASE:
+		offset = 0x04;
+		break;
+	case MICROVM_VIRTIO_CONSOLE_MMIO_BASE:
+		offset = 0x08;
+		break;
+	case MICROVM_VIRTIO_DISTRO_BLK_MMIO_BASE:
+		offset = 0x0c;
+		break;
+	case MICROVM_VIRTIO_RUNTIME_BLK_MMIO_BASE:
+		offset = 0x10;
+		break;
+	case MICROVM_VIRTIO_CUSTOM_BLK_MMIO_BASE:
+		offset = 0x14;
+		break;
+	case MICROVM_VIRTIO_SCRATCH_BLK_MMIO_BASE:
+		offset = 0x18;
+		break;
+	default:
+		dev_err(&pdev->dev,
+			"shared-status ABI has no slot for MMIO base %#llx\n",
+			(unsigned long long)resource->start);
+		return -EINVAL;
+	}
+
+	status_gpa = MICROVM_SHARED_STATUS_PAGE_GPA + offset;
+#else
+	if (of_property_read_u64(pdev->dev.of_node,
+				 "microsoft,shared-interrupt-status",
+				 &status_gpa))
+		return 0;
+#endif
+	vm_dev->shared_status = devm_memremap(&pdev->dev, status_gpa,
+					       sizeof(*vm_dev->shared_status),
+					       MEMREMAP_WB);
+	if (IS_ERR(vm_dev->shared_status))
+		return PTR_ERR(vm_dev->shared_status);
+
+	dev_info(&pdev->dev, "using shared interrupt status at %pa\n",
+		 &status_gpa);
+	return 0;
+}
+#else
+static int vm_setup_shared_status(struct virtio_mmio_device *vm_dev)
+{
+	return 0;
+}
+#endif
+
 /* Configuration interface */
 
 static u64 vm_get_features(struct virtio_device *vdev)
@@ -290,8 +385,16 @@
 	irqreturn_t ret = IRQ_NONE;
 
 	/* Read and acknowledge interrupts */
+#ifdef CONFIG_VIRTIO_MMIO_SHARED_STATUS
+	if (vm_dev->shared_status) {
+		status = xchg(vm_dev->shared_status, 0);
+	} else {
+#endif
 	status = readl(vm_dev->base + VIRTIO_MMIO_INTERRUPT_STATUS);
 	writel(status, vm_dev->base + VIRTIO_MMIO_INTERRUPT_ACK);
+#ifdef CONFIG_VIRTIO_MMIO_SHARED_STATUS
+	}
+#endif
 
 	if (unlikely(status & VIRTIO_MMIO_INT_CONFIG)) {
 		virtio_config_changed(&vm_dev->vdev);
@@ -584,6 +687,10 @@
 	vm_dev->vdev.config = &virtio_mmio_config_ops;
 	vm_dev->pdev = pdev;
 
+	rc = vm_setup_shared_status(vm_dev);
+	if (rc)
+		goto free_vm_dev;
+
 	vm_dev->base = devm_platform_ioremap_resource(pdev, 0);
 	if (IS_ERR(vm_dev->base)) {
 		rc = PTR_ERR(vm_dev->base);
@@ -812,6 +919,13 @@
 
 static int __init virtio_mmio_init(void)
 {
+#if defined(CONFIG_VIRTIO_MMIO_SHARED_STATUS) && defined(CONFIG_X86)
+	microvm_shared_status_available = e820__mapped_all(
+		MICROVM_SHARED_STATUS_PAGE_GPA,
+		MICROVM_SHARED_STATUS_PAGE_GPA + MICROVM_SHARED_STATUS_PAGE_SIZE,
+		E820_TYPE_RESERVED);
+#endif
+
 	return platform_driver_register(&virtio_mmio_driver);
 }
