Add a Nanvix-style per-byte debug console on I/O port 0xE9 (earlycon=xe9).

Redirects kernel log output to a single-outb-per-byte port, cheaper than the 8250
UART (which polls the line-status register per byte). Used by the microvm VMM's 0xE9
debug console. Apply with: patch -p1 < kernel/patches/0001-microvm-xe9-earlycon.patch

--- forwarded from microvm ---

--- a/arch/x86/kernel/early_printk.c	2026-07-04 04:44:22.000000000 -0700
+++ b/arch/x86/kernel/early_printk.c	2026-07-07 06:13:47.278426485 -0700
@@ -21,6 +21,7 @@
 #include <linux/usb/xhci-dbgp.h>
 #include <asm/pci_x86.h>
 #include <linux/static_call.h>
+#include <linux/serial_core.h>
 
 /* Simple VGA output */
 #define VGABASE		(__ISA_IO_base + 0xb8000)
@@ -447,3 +448,24 @@
 }
 
 early_param("earlyprintk", setup_early_printk);
+
+/*
+ * microvm: Nanvix-style per-byte debug console on I/O port 0xE9.
+ *
+ * Each character is emitted with a single `outb` to port 0xE9, which the VMM turns into
+ * one host write. This is cheaper than the 8250 earlycon, which additionally polls the
+ * line-status register before every byte (two port accesses per character). Select it with
+ * "earlycon=xe9" on the kernel command line.
+ */
+static void early_xe9_write(struct console *console, const char *s, unsigned int count)
+{
+	while (count--)
+		outb(*s++, 0xe9);
+}
+
+static int __init early_xe9_setup(struct earlycon_device *device, const char *options)
+{
+	device->con->write = early_xe9_write;
+	return 0;
+}
+EARLYCON_DECLARE(xe9, early_xe9_setup);
