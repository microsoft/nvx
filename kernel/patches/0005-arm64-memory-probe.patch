From: NVX maintainers
Subject: [PATCH] arm64: enable the sysfs memory probe interface

NVX microVM snapshots reserve a fixed RAM capacity and expose newly mapped
128-MiB blocks to the guest during restore. Enable the generic sysfs probe
interface so the restore agent can add those blocks before onlining them.

--- a/arch/arm64/Kconfig
+++ b/arch/arm64/Kconfig
@@ -1599,7 +1599,14 @@ config ARCH_SPARSEMEM_ENABLE
 	def_bool y
 	select SPARSEMEM_VMEMMAP_ENABLE
 
+config ARCH_MEMORY_PROBE
+	bool "Enable sysfs memory/probe interface"
+	depends on MEMORY_HOTPLUG
+	help
+	  This option enables the sysfs memory/probe interface used by the NVX
+	  microVM restore agent to activate newly mapped memory blocks.
+
 config HW_PERF_EVENTS
 	def_bool y
 	depends on ARM_PMU
