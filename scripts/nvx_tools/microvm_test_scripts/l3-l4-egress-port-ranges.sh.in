set -eu
fail() {
    code="$1"
    echo "NVX-L3-L4-PORT-RANGES-FAIL code=$code"
    nvx-exit "$code"
    exit "$code"
}

# The probes keep their results in TMPDIR, or else in the guest's private
# /tmp. The host's /tmp is shared, so the tests that run this script in the
# host's shell give each run a TMPDIR of its own (#1007).
probe_dir=${TMPDIR:-/tmp}

probe_tcp() {
    if response=$(wget -T 2 -qO- "http://@GATEWAY_IPV4@:$2/$1" 2>/dev/null); then
        if [ "$response" = "NVX-EGRESS-PROBE-$1" ]; then
            echo reached
        else
            echo unexpected
        fi
    else
        echo blocked
    fi >"$probe_dir/nvx-egress-$1"
}

# Only the host can observe UDP delivery. A denied flow may return 1; sender
# execution failures must not pass.
probe_udp() {
    status=0
    printf 'NVX-EGRESS-PROBE-%s' "$1" |
        nc -u -w 1 @GATEWAY_IPV4@ "$2" >/dev/null 2>&1 || status=$?
    case "$status" in
        0 | 1) echo sent ;;
        *) echo "failed-$status" ;;
    esac >"$probe_dir/nvx-egress-$1"
}

rm -f "$probe_dir"/nvx-egress-*
probe_tcp tcp-below @BELOW_PORT@ &
probe_tcp tcp-first @FIRST_PORT@ &
probe_tcp tcp-inside @INSIDE_PORT@ &
probe_tcp tcp-last @LAST_PORT@ &
probe_tcp tcp-above @ABOVE_PORT@ &
probe_udp udp-below @BELOW_PORT@ &
probe_udp udp-first @FIRST_PORT@ &
probe_udp udp-inside @INSIDE_PORT@ &
probe_udp udp-last @LAST_PORT@ &
probe_udp udp-above @ABOVE_PORT@ &
wait
for probe in tcp-below tcp-first tcp-inside tcp-last tcp-above \
    udp-below udp-first udp-inside udp-last udp-above; do
    [ -s "$probe_dir/nvx-egress-$probe" ] || fail 70
    echo "NVX-L3-L4-PROBE $probe=$(cat "$probe_dir/nvx-egress-$probe")"
done

echo NVX-L3-L4-EGRESS-PORT-RANGES-OK
nvx-exit 0
