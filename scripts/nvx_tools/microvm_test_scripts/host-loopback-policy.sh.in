set -eu
fail() {
    code="$1"
    echo "NVX-HOST-LOOPBACK-FAIL code=$code"
    nvx-exit "$code"
    exit "$code"
}

case "@MODE@" in
deny)
    if wget -T 2 -qO /dev/null http://@GATEWAY_IPV4@:@GENERAL_PORT@/general; then
        fail 90
    fi
    proxy=$(wget -T 5 -qO- http://@GATEWAY_IPV4@:@PROXY_PORT@/proxy) ||
        fail 91
    [ "$proxy" = NVX-HOST-LOOPBACK-PROXY ] || fail 92
    echo NVX-HOST-LOOPBACK-DENY-OK
    ;;
allow)
    general=$(wget -T 5 -qO- http://@GATEWAY_IPV4@:@GENERAL_PORT@/general) ||
        fail 93
    [ "$general" = NVX-HOST-LOOPBACK-GENERAL ] || fail 94
    rm -f /tmp/nvx-host-loopback-inbound
    nc -l -p @GUEST_PORT@ -w 5 >/tmp/nvx-host-loopback-inbound &
    listener_pid=$!
    port_hex=$(printf '%04X' @GUEST_PORT@)
    tries=0
    while ! awk -v port=":$port_hex" \
        '$2 ~ port "$" && $4 == "0A" { found = 1 } END { exit !found }' \
        /proc/net/tcp; do
        kill -0 "$listener_pid" 2>/dev/null || fail 95
        [ "$tries" -lt 100 ] || fail 95
        tries=$((tries + 1))
        sleep 0.05
    done
    echo NVX-HOST-LOOPBACK-INGRESS-READY
    wait "$listener_pid" || true
    if ! grep -qx NVX-HOST-LOOPBACK-INBOUND /tmp/nvx-host-loopback-inbound; then
        wc -c /tmp/nvx-host-loopback-inbound
        od -An -tx1 /tmp/nvx-host-loopback-inbound
        fail 97
    fi
    echo NVX-HOST-LOOPBACK-ALLOW-OK
    ;;
*)
    fail 98
    ;;
esac

nvx-exit 0
