set -eu
fail() {
    code="$1"
    echo "NVX-INTERRUPT-MAP-FAIL code=$code"
    nvx-exit "$code"
    exit "$code"
}

# Counts the virtio devices that a driver has bound.
bound_devices() {
    bound=0
    for device in /sys/bus/virtio/drivers/*/virtio*; do
        [ -e "$device" ] && bound=$((bound + 1))
    done
    echo "$bound"
}

# Prints the base of the MMIO window that /proc/iomem lists under the name of
# the virtio-mmio platform device $1.
window_base() {
    while IFS=' ' read -r range separator name _; do
        [ "$separator" = : ] && [ "$name" = "$1" ] || continue
        echo "${range%%-*}"
        return 0
    done </proc/iomem
    return 1
}

# Prints the base of the MMIO window of the virtio device $1.
device_base() {
    window_base "$(basename "$(dirname "$(readlink -f "/sys/bus/virtio/devices/$1")")")"
}

# Prints the interrupt whose handlers include the virtio device $1's, which
# the virtio-mmio driver names after the device.
device_irq() {
    for irq in /sys/kernel/irq/*; do
        case ",$(cat "$irq/actions")," in
            *",$1,"*)
                echo "${irq##*/}"
                return 0
                ;;
        esac
    done
    return 1
}

# Prints how many times the interrupt $1 has fired, on every processor.
irq_count() {
    total=0
    for count in $(tr ',' ' ' <"/sys/kernel/irq/$1/per_cpu_count"); do
        total=$((total + count))
    done
    echo "$total"
}

# Waits up to $3 hundredths of a second, or a second, for the interrupt $1
# to have fired more than $2 times. A console's driver polls the used ring
# for its output, so a write can return before the interrupt that its
# completion raises arrives.
await_irq() {
    tries=0
    while [ "$(irq_count "$1")" -le "$2" ] && [ "$tries" -lt "${3:-100}" ]; do
        sleep 0.01
        tries=$((tries + 1))
    done
}

# Reports each virtio device's window and the interrupt that its driver
# requested, after the step $1: the interrupt's controller, input, trigger,
# handlers, and count, and how many of its interrupts lately found no work
# for any handler, which Linux keeps to detect a stuck line.
report() {
    for device in /sys/bus/virtio/devices/virtio*; do
        name=${device##*/}
        base=$(device_base "$name") || fail 21
        irq=$(device_irq "$name") || fail 22
        line=/sys/kernel/irq/$irq
        echo "NVX-INTERRUPT-MAP step=$1 base=0x$base device=$name irq=$irq" \
            "chip=$(cat "$line/chip_name") hwirq=$(cat "$line/hwirq")" \
            "type=$(cat "$line/type") actions=$(cat "$line/actions")" \
            "count=$(irq_count "$irq")" \
            "unhandled=$(awk '$1 == "unhandled" { print $2 }' "/proc/irq/$irq/spurious")"
    done
}

# Makes each virtio device interrupt, one device at a time: the NIC with an
# echo of its gateway, the host filesystem with a read of its share, the
# consoles with output, and the block devices with a read of the read-only
# one and a flushed write to the writable one, past the page cache. Each
# device's traffic must raise the device's own interrupt before the next
# device's starts, so two devices whose interrupts were crossed cannot each
# raise the other's: the consoles' drivers poll the used ring for their
# output, so a console's writes complete even when its interrupt reaches
# another handler.
traffic() {
    for device in /sys/bus/virtio/devices/virtio*; do
        name=${device##*/}
        base=$(device_base "$name") || fail 21
        irq=$(device_irq "$name") || fail 22
        fired=$(irq_count "$irq")
        writes=0
        case "$base" in
            d0000000) ping -c 2 -W 2 10.0.0.1 >/dev/null || fail 30 ;;
            d0001000) cat /mnt/share/seed >/dev/null || fail 31 ;;
            d0002000)
                # When a console's driver takes its buffer back before the
                # device reads the used event, the device rightly skips the
                # interrupt, so write until one interrupts.
                while [ "$(irq_count "$irq")" -le "$fired" ] && [ "$writes" -lt 16 ]; do
                    echo NVX-INTERRUPT-MAP-CONSOLE
                    writes=$((writes + 1))
                    await_irq "$irq" "$fired" 10
                done
                ;;
            d0003000)
                block=$(ls "$device/block") || fail 33
                blockdev --flushbufs "/dev/$block" || fail 33
                dd if="/dev/$block" of=/dev/null bs=4096 count=16 2>/dev/null || fail 33
                ;;
            d0006000)
                block=$(ls "$device/block") || fail 34
                dd if=/dev/zero of="/dev/$block" bs=4096 count=16 conv=fsync 2>/dev/null ||
                    fail 34
                ;;
            d0007000)
                # As for the boot console, a byte at a time, each in a buffer
                # of its own: fewer bytes than the 44-byte header of the
                # control-session protocol, which the console parses its
                # input as.
                while [ "$(irq_count "$irq")" -le "$fired" ] && [ "$writes" -lt 16 ]; do
                    printf . >/dev/hvc2 || fail 35
                    writes=$((writes + 1))
                    await_irq "$irq" "$fired" 10
                done
                ;;
            *) fail 36 ;;
        esac
        await_irq "$irq" "$fired"
        if [ "$(irq_count "$irq")" -le "$fired" ]; then
            echo "NVX-INTERRUPT-MAP-QUIET base=0x$base device=$name irq=$irq" \
                "count=$(irq_count "$irq")"
            fail 37
        fi
    done
}

tries=0
while [ "$(bound_devices)" -lt @DEVICES@ ] && [ "$tries" -lt 200 ]; do
    sleep 0.05
    tries=$((tries + 1))
done
[ "$(bound_devices)" -eq @DEVICES@ ] || fail 20

report boot
@CAPTURE@
traffic
report traffic
# The APIC errors and spurious PIC interrupts (ERR), the level-triggered
# interrupts that the IOAPIC misrouted (MIS), and the spurious APIC
# interrupts (SPU).
echo "NVX-INTERRUPT-MAP-ERRORS" \
    "err=$(awk '$1 == "ERR:" { print $2 }' /proc/interrupts)" \
    "mis=$(awk '$1 == "MIS:" { print $2 }' /proc/interrupts)" \
    "spu=$(awk '$1 == "SPU:" { print $2 }' /proc/interrupts)"
# The whole map, for the log.
cat /proc/interrupts
echo NVX-INTERRUPT-MAP-OK
nvx-exit 0
