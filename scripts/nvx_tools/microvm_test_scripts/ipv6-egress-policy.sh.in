set -eu
fail() {
    code="$1"
    echo "NVX-IPV6-EGRESS-FAIL code=$code"
    nvx-exit "$code"
    exit "$code"
}

# The kernel's tables show the IPv6 identity, whichever userland configured it.
grep -q 'virtnet_ip6=@GUEST_IPV6@/@PREFIX_LENGTH@' /proc/cmdline || fail 60
grep -q 'virtnet_gw6=@GATEWAY_IPV6@' /proc/cmdline || fail 61
grep -q '^@GUEST_IPV6_HEX@ [0-9a-f]* @PREFIX_LENGTH_HEX@ ' /proc/net/if_inet6 ||
    fail 62
grep -q '^@ANY_IPV6_HEX@ 00 @ANY_IPV6_HEX@ 00 @GATEWAY_IPV6_HEX@ ' \
    /proc/net/ipv6_route || fail 63
# The guest names the gateway whose DNS service the policy admits, if any.
dns=$(sed -n 's/.*virtnet_dns=\([^ ]*\).*/\1/p' /proc/cmdline)
if [ -n "$dns" ]; then
    grep -Fqx "nameserver $dns" /etc/resolv.conf || fail 64
fi
echo "NVX-IPV6-EGRESS-DNS ${dns:-none}"

# The probes keep their results in TMPDIR, or else in the guest's private
# /tmp. The host's /tmp is shared, so the tests that run this script in the
# host's shell give each run a TMPDIR of its own (#1007).
probe_dir=${TMPDIR:-/tmp}

probe_tcp() {
    if response=$(wget -T 2 -qO- "$2" 2>/dev/null); then
        if [ "$response" = "NVX-EGRESS-PROBE-$1" ]; then
            echo reached
        else
            echo unexpected
        fi
    else
        echo blocked
    fi >"$probe_dir/nvx-egress-$1"
}

# Only the host can observe UDP delivery. A denied flow may return 1; sender
# execution failures must not pass.
probe_udp() {
    status=0
    printf 'NVX-EGRESS-PROBE-%s' "$1" |
        nc -u -w 1 "$2" "$3" >/dev/null 2>&1 || status=$?
    case "$status" in
    0 | 1) echo sent ;;
    *) echo "failed-$status" ;;
    esac >"$probe_dir/nvx-egress-$1"
}

probe_icmp() {
    if ping -c 1 -W 2 "$2" >/dev/null 2>&1; then
        echo reached
    else
        echo blocked
    fi >"$probe_dir/nvx-egress-$1"
}

rm -f "$probe_dir"/nvx-egress-*
probe_tcp tcp6-named 'http://[@GATEWAY_IPV6@]:@NAMED_PORT@/tcp6-named' &
probe_tcp tcp6-other 'http://[@GATEWAY_IPV6@]:@OTHER_PORT@/tcp6-other' &
probe_udp udp6-named @GATEWAY_IPV6@ @NAMED_PORT@ &
probe_icmp icmp6 @GATEWAY_IPV6@ &
probe_tcp tcp4-named 'http://@GATEWAY_IPV4@:@NAMED_PORT@/tcp4-named' &
wait
for probe in tcp6-named tcp6-other udp6-named icmp6 tcp4-named; do
    [ -s "$probe_dir/nvx-egress-$probe" ] || fail 70
    echo "NVX-L3-L4-PROBE $probe=$(cat "$probe_dir/nvx-egress-$probe")"
done

echo NVX-IPV6-EGRESS-OK
nvx-exit 0
