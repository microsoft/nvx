virtio_irq_total() {
  awk -v expected="$expected" '/virtio/ { for (cpu = 0; cpu < expected; cpu++) total += $(cpu + 2) } END { print total + 0 }' /proc/interrupts
}
irq_before="$(virtio_irq_total)"
ping -c 2 -W 1 "@NETWORK_GATEWAY" >/dev/null
irq_after="$(virtio_irq_total)"
[ "$irq_after" -gt "$irq_before" ] || { echo "SMP-GIC-FAIL before=$irq_before after=$irq_after"; exit 91; }
echo "SMP-GIC-OK before=$irq_before after=$irq_after"
