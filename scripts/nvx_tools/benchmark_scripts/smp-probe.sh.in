set -eu
trap 'status=$?; if [ "$status" -ne 0 ]; then nvx-exit "$status"; fi' EXIT
expected=@PROCESSORS
architecture=@ARCHITECTURE
timer_name=loc
timer_failure=SMP-LAPIC-FAIL
identity_name=apic
read_dt_mpidr() {
  mpidr_cells="$(od -An -tx1 -v "$1/../#address-cells" | tr -d '[:space:]')" || return 1
  mpidr_raw="$(od -An -tx1 -v "$1/reg" | tr -d '[:space:]')" || return 1
  case "$mpidr_cells:${#mpidr_raw}" in
    00000001:8 | 00000002:16) ;;
    *) return 1 ;;
  esac
  printf '%016x\n' "0x$mpidr_raw"
}
if [ "$architecture" = aarch64 ]; then
  timer_name=arch_timer
  timer_failure=SMP-TIMER-FAIL
  identity_name=dt_mpidr
fi
online="$(getconf _NPROCESSORS_ONLN)"
[ "$online" -eq "$expected" ] || { echo "SMP-ONLINE-FAIL expected=$expected actual=$online"; exit 81; }
loc_before="$(awk -v expected="$expected" -v architecture="$architecture" '(architecture == "x86_64" && $1 == "LOC:") || (architecture == "aarch64" && $NF == "arch_timer") { for (cpu = 0; cpu < expected; cpu++) printf "%s%s", $(cpu + 2), (cpu + 1 == expected ? "" : " "); exit }' /proc/interrupts)"
[ "$(printf "%s\n" "$loc_before" | awk '{ print NF }')" -eq "$expected" ] || { echo "$timer_failure missing-local-timer-counters"; exit 87; }
worker_dir="/tmp/nvx-smp-probe-$$"
worker_script="$worker_dir/worker"
rm -rf "$worker_dir"
mkdir -p "$worker_dir"
cat >"$worker_script" <<'NVX_SMP_WORKER'
#!/bin/sh
set -eu
cpu="$1"
result="$2"
apic_id="$3"
architecture="${4:-x86_64}"
timer_failure=SMP-LAPIC-FAIL
[ "$architecture" != aarch64 ] || timer_failure=SMP-TIMER-FAIL
actual="$(awk '{ print $39 }' /proc/self/stat)"
[ "$actual" -eq "$cpu" ] || { echo "SMP-WORKER-FAIL requested=$cpu actual=$actual"; exit 87; }
read_loc_counter() {
  while read -r label cpu0 cpu1 cpu2 cpu3 cpu4 cpu5 cpu6 cpu7 rest; do
    if [ "$architecture" = aarch64 ]; then
      case " $cpu0 $cpu1 $cpu2 $cpu3 $cpu4 $cpu5 $cpu6 $cpu7 $rest " in
        *" arch_timer "*) ;;
        *) continue ;;
      esac
    elif [ "$label" != "LOC:" ]; then
      continue
    fi
    case "$cpu" in
      0) current=$cpu0 ;;
      1) current=$cpu1 ;;
      2) current=$cpu2 ;;
      3) current=$cpu3 ;;
      4) current=$cpu4 ;;
      5) current=$cpu5 ;;
      6) current=$cpu6 ;;
      7) current=$cpu7 ;;
      *) echo "SMP-WORKER-FAIL unsupported-cpu=$cpu"; exit 87 ;;
    esac
    return 0
  done </proc/interrupts
  echo "$timer_failure cpu=$cpu missing-local-timer-counter"
  exit 87
}
read_loc_counter
before=$current
timer_attempts=10000
attempts=0
while [ "$attempts" -lt "$timer_attempts" ]; do
  read_loc_counter
  [ "$current" -gt "$before" ] && break
  attempts=$((attempts + 1))
done
[ "$current" -gt "$before" ] || { echo "$timer_failure cpu=$cpu before=$before after=$current attempts=$attempts"; exit 88; }
printf '%s %s %s\n' "$actual" "$current" "$apic_id" >"$result"
NVX_SMP_WORKER
chmod +x "$worker_script"
workers=0
worker_pids=""
for cpu in $(seq 0 $((expected - 1))); do
  topology="/sys/devices/system/cpu/cpu${cpu}/topology"
  [ "$(cat "$topology/physical_package_id")" -eq 0 ] || exit 82
  if [ "$architecture" = x86_64 ]; then
    [ "$(cat "$topology/die_id")" -eq 0 ] || exit 83
  fi
  [ "$(cat "$topology/core_id")" -eq "$cpu" ] || exit 84
  [ "$(cat "$topology/thread_siblings_list")" = "$cpu" ] || exit 85
  if [ "$architecture" = aarch64 ]; then
    apic_id="$(read_dt_mpidr "/sys/devices/system/cpu/cpu${cpu}/of_node")" || { echo "SMP-MPIDR-FAIL cpu=$cpu invalid-DT-reg"; exit 86; }
    expected_id="$(printf '%016x' "$cpu")"
    [ "$apic_id" = "$expected_id" ] || { echo "SMP-MPIDR-FAIL cpu=$cpu dt_mpidr=$apic_id expected=$expected_id"; exit 86; }
    apic_id="0x$apic_id"
  else
    apic_id="$(awk -v target="$cpu" '$1 == "processor" { processor = $3 } $1 == "apicid" && processor == target { print $3; exit }' /proc/cpuinfo)"
    [ "$apic_id" -eq "$cpu" ] || { echo "SMP-APIC-FAIL cpu=$cpu apic=$apic_id"; exit 86; }
  fi
  result="$worker_dir/$cpu"
  taskset -c "$cpu" "$worker_script" "$cpu" "$result" "$apic_id" "$architecture" &
  worker_pids="$worker_pids $!"
  workers=$((workers + 1))
done
for pid in $worker_pids; do
  wait "$pid"
done
loc_after="$(awk -v expected="$expected" -v architecture="$architecture" '(architecture == "x86_64" && $1 == "LOC:") || (architecture == "aarch64" && $NF == "arch_timer") { for (cpu = 0; cpu < expected; cpu++) printf "%s%s", $(cpu + 2), (cpu + 1 == expected ? "" : " "); exit }' /proc/interrupts)"
[ "$(printf "%s\n" "$loc_after" | awk '{ print NF }')" -eq "$expected" ] || { echo "$timer_failure missing-local-timer-counters"; exit 87; }
for cpu in $(seq 0 $((expected - 1))); do
  read -r actual current apic_id <"$worker_dir/$cpu"
  field=$((cpu + 1))
  before="$(printf "%s\n" "$loc_before" | awk -v field="$field" '{ print $field }')"
  after="$(printf "%s\n" "$loc_after" | awk -v field="$field" '{ print $field }')"
  [ "$after" -gt "$before" ] || { echo "$timer_failure cpu=$cpu before=$before after=$after"; exit 88; }
  [ "$after" -ge "$current" ] || { echo "$timer_failure cpu=$cpu worker=$current after=$after"; exit 88; }
  echo "SMP-WORKER-OK cpu=$cpu $identity_name=$apic_id actual=$actual ${timer_name}_after=$after"
  if [ "$cpu" -gt 0 ]; then
    ipi="$(awk -v field=$((cpu + 2)) -v architecture="$architecture" '(architecture == "x86_64" && $1 ~ /^(RES|CAL):$/) || (architecture == "aarch64" && $1 ~ /^IPI[01]:$/) { total += $field } END { print total + 0 }' /proc/interrupts)"
    [ "$ipi" -gt 0 ] || { echo "SMP-IPI-FAIL cpu=$cpu count=$ipi"; exit 89; }
  fi
done
echo "SMP-INTERRUPTS-OK ${timer_name}_before=$loc_before ${timer_name}_after=$loc_after"
echo "SMP-TOPOLOGY-OK requested=$expected online=$online sockets=1 cores=$expected threads=1 @IDENTITY_LIST_NAME=@APIC_IDS bsp=0 workers=$workers"
rm -rf "$worker_dir"
@{NETWORK_PROBE}echo @COMPLETION_MARKER
