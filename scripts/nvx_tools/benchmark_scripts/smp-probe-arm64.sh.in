set -eu
trap 'status=$?; if [ "$status" -ne 0 ]; then nvx-exit "$status"; fi' EXIT
expected=@PROCESSORS
online="$(getconf _NPROCESSORS_ONLN)"
[ "$online" -eq "$expected" ] || { echo "SMP-ONLINE-FAIL expected=$expected actual=$online"; exit 81; }
timer_counts() {
  awk -v expected="$expected" '$0 ~ /arch_timer/ { for (cpu = 0; cpu < expected; cpu++) printf "%s%s", $(cpu + 2), (cpu + 1 == expected ? "" : " "); exit }' /proc/interrupts
}
timer_before="$(timer_counts)"
[ "$(printf "%s\n" "$timer_before" | awk '{ print NF }')" -eq "$expected" ] || { echo "SMP-TIMER-FAIL missing-arch-timer-counters"; exit 87; }
worker_dir="/tmp/nvx-smp-probe-$$"
worker_script="$worker_dir/worker"
rm -rf "$worker_dir"
mkdir -p "$worker_dir"
cat >"$worker_script" <<'NVX_SMP_WORKER'
#!/bin/sh
set -eu
cpu="$1"
result="$2"
actual="$(awk '{ print $39 }' /proc/self/stat)"
[ "$actual" -eq "$cpu" ] || { echo "SMP-WORKER-FAIL requested=$cpu actual=$actual"; exit 87; }
read_timer_counter() {
  current="$(awk -v field=$((cpu + 2)) '$0 ~ /arch_timer/ { print $field; exit }' /proc/interrupts)"
  case "$current" in
    '' | *[!0-9]*) echo "SMP-TIMER-FAIL cpu=$cpu missing-arch-timer-counter"; exit 87 ;;
  esac
}
read_timer_counter
before=$current
attempts=0
while [ "$attempts" -lt 100 ]; do
  sleep 0.01
  read_timer_counter
  [ "$current" -gt "$before" ] && break
  attempts=$((attempts + 1))
done
[ "$current" -gt "$before" ] || { echo "SMP-TIMER-FAIL cpu=$cpu before=$before after=$current attempts=$attempts"; exit 88; }
printf '%s %s\n' "$actual" "$current" >"$result"
NVX_SMP_WORKER
chmod +x "$worker_script"
workers=0
worker_pids=""
for cpu in $(seq 0 $((expected - 1))); do
  topology="/sys/devices/system/cpu/cpu${cpu}/topology"
  package_id="$(cat "$topology/physical_package_id" 2>/dev/null || echo 0)"
  die_id="$(cat "$topology/die_id" 2>/dev/null || echo 0)"
  core_id="$(cat "$topology/core_id" 2>/dev/null || echo "$cpu")"
  siblings="$(cat "$topology/thread_siblings_list" 2>/dev/null || echo "$cpu")"
  [ "$package_id" -eq 0 ] || exit 82
  [ "$die_id" -eq 0 ] || exit 83
  [ "$core_id" -eq "$cpu" ] || exit 84
  [ "$siblings" = "$cpu" ] || exit 85
  result="$worker_dir/$cpu"
  taskset -c "$cpu" "$worker_script" "$cpu" "$result" &
  worker_pids="$worker_pids $!"
  workers=$((workers + 1))
done
for pid in $worker_pids; do
  wait "$pid"
done
timer_after="$(timer_counts)"
[ "$(printf "%s\n" "$timer_after" | awk '{ print NF }')" -eq "$expected" ] || { echo "SMP-TIMER-FAIL missing-arch-timer-counters"; exit 87; }
for cpu in $(seq 0 $((expected - 1))); do
  read -r actual current <"$worker_dir/$cpu"
  field=$((cpu + 1))
  before="$(printf "%s\n" "$timer_before" | awk -v field="$field" '{ print $field }')"
  after="$(printf "%s\n" "$timer_after" | awk -v field="$field" '{ print $field }')"
  [ "$after" -gt "$before" ] || { echo "SMP-TIMER-FAIL cpu=$cpu before=$before after=$after"; exit 88; }
  [ "$after" -ge "$current" ] || { echo "SMP-TIMER-FAIL cpu=$cpu worker=$current after=$after"; exit 88; }
  echo "SMP-WORKER-OK cpu=$cpu actual=$actual timer_after=$after"
  if [ "$cpu" -gt 0 ]; then
    ipi="$(awk -v field=$((cpu + 2)) '$1 ~ /^IPI[0-9]+:/ { total += $field } END { print total + 0 }' /proc/interrupts)"
    [ "$ipi" -gt 0 ] || { echo "SMP-IPI-FAIL cpu=$cpu count=$ipi"; exit 89; }
  fi
done
echo "SMP-INTERRUPTS-OK timer_before=$timer_before timer_after=$timer_after"
echo "SMP-TOPOLOGY-OK requested=$expected online=$online sockets=1 cores=$expected threads=1 cpu_ids=@APIC_IDS bsp=0 workers=$workers"
rm -rf "$worker_dir"
@{NETWORK_PROBE}echo @COMPLETION_MARKER
