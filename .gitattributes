* text=auto

*.c text eol=lf
*.md text eol=lf
# Unified diff context includes blank lines and space-prefixed tabs.
*.patch text eol=lf whitespace=-blank-at-eol,-space-before-tab
*.py text eol=lf
*.sh text eol=lf
*.sh.in text eol=lf
ubuntu/packages.lock.json text eol=lf
azurelinux/packages.lock.json text eol=lf
guest/* text eol=lf
guest/**/* text eol=lf
Dockerfile text eol=lf
kernel/config-microvm text eol=lf
kernel/config-microvm-debug text eol=lf
# Linux hosts read the setup tool manifest, including copies staged from Windows.
scripts/setup/tool-versions.conf text eol=lf
# `cargo package` packs the files of the working tree, so the published crates hold the files of
# their commit only if they are checked out unchanged: check nvx-rs and nvx-sys out with LF line
# endings on every platform, whatever core.autocrlf says.
nvx-rs/** text=auto eol=lf
crates/nvx-sys/** text=auto eol=lf
# OpenVMM wrote these template manifests: they are bytes, never text.
nvx-rs/tests/fixtures/template/**/manifest.bin binary

.github/workflows/*.lock.yml linguist-generated=true