* text=auto

*.c text eol=lf
*.md text eol=lf
# Unified diff context includes blank lines and space-prefixed tabs.
*.patch text eol=lf whitespace=-blank-at-eol,-space-before-tab
*.py text eol=lf
*.sh text eol=lf
*.sh.in text eol=lf
ubuntu/packages.lock.json text eol=lf
azurelinux/packages.lock.json text eol=lf
guest/* text eol=lf
guest/**/* text eol=lf
Dockerfile text eol=lf
kernel/config-microvm text eol=lf
kernel/config-microvm-debug text eol=lf
# Linux hosts read the setup tool manifest, including copies staged from Windows.
scripts/setup/tool-versions.conf text eol=lf
# `cargo package` packs the files of the working tree, so the published nvx crate holds the files
# of its commit only if they are checked out unchanged: check nvx-rs out with LF line endings on
# every platform, whatever core.autocrlf says.
nvx-rs/** text=auto eol=lf

.github/workflows/*.lock.yml linguist-generated=true
# Recorded from the Python code that nvx-rs replaced, by scripts/nvx_rs_fixtures.py
# and, for the scenarios of nvx.py run in cli.json, scripts/nvx_rs_run_fixtures.py,
# which microsoft/nvx#359 and microsoft/nvx#638 retired with that code, so nothing
# regenerates them: they are the reference of that behavior, and a deliberate change
# of behavior updates them by hand, in the same change (nvx-rs/README.md, Python
# parity).
nvx-rs/src/host/python/unicode.rs linguist-generated=true
nvx-rs/tests/fixtures/cli.json linguist-generated=true
nvx-rs/tests/fixtures/python.json linguist-generated=true
nvx-rs/tests/fixtures/sandbox.json linguist-generated=true
nvx-rs/tests/fixtures/sandbox_options.json linguist-generated=true