{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openvmm:native-local:run-result:v1",
  "title": "Final run.sh --json receipt; not a Specula trace or verdict",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "run_id", "backend", "evidence"],
  "properties": {
    "schema": {"const": "native-openvmm-run-result-v1"},
    "status": {"enum": ["passed", "failed"]},
    "run_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{12}$"},
    "backend": {"const": "mshv"},
    "evidence": {"type": "string", "pattern": "^/.+/evidence\\.json$"}
  }
}
