#!/bin/sh
# PID 1 for the RAM initramfs. Mounts the pseudo-filesystems, prints a recognizable
# boot-completion banner (used as the cold-start marker), and drops to an interactive shell.
mount -t proc none /proc
mount -t sysfs none /sys
mount -t devtmpfs none /dev 2>/dev/null || mdev -s
mount -t tmpfs none /tmp
export PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME=/root TERM=linux
ifconfig lo 127.0.0.1 up

fatal() {
    echo "$*" >&2
    /bin/busybox reboot -f
    exit 1
}
nvx_snapshot_before_exec=$(sed -n 's/.*nvx_snapshot_before_exec=\([^ ]*\).*/\1/p' /proc/cmdline)
mount_virtfs() {
    # KVM/WHP expose a phram image as /dev/mtdblock0. A snapshot-before-exec run deliberately
    # defers this first mount until restore has attached the per-run image.
    if [ -e /dev/mtdblock0 ]; then
        vdir=$(sed -n 's/.*virtfs_dir=\([^ ]*\).*/\1/p' /proc/cmdline)
        [ -n "$vdir" ] || vdir=/mnt/host
        vfs=$(sed -n 's/.*virtfs_fs=\([^ ]*\).*/\1/p' /proc/cmdline)
        [ -n "$vfs" ] || vfs=squashfs
        vmode=$(sed -n 's/.*virtfs_mode=\([^ ]*\).*/\1/p' /proc/cmdline)
        [ -n "$vmode" ] || vmode=ro
        mkdir -p "$vdir"
        if mount -t "$vfs" -o "$vmode" /dev/mtdblock0 "$vdir" 2>/dev/null; then
            echo "virtfs: mounted host directory at $vdir ($vfs,$vmode)"
        else
            echo "virtfs: failed to mount /dev/mtdblock0 at $vdir" >&2
        fi
    fi
}
if [ "$nvx_snapshot_before_exec" != 1 ]; then
    mount_virtfs
fi
# virt-net: if the VMM attached a NIC (see --net or --net-config), configure the only
# non-loopback interface from its virtnet_* command-line tokens. External networking includes
# virtnet_required=1 and must complete in full before the guest reports boot success. Standalone
# --net retains best-effort setup and supplies virtnet_gw.
nrequired=$(sed -n 's/.*virtnet_required=\([^ ]*\).*/\1/p' /proc/cmdline)
nip=$(sed -n 's/.*virtnet_ip=\([^ ]*\).*/\1/p' /proc/cmdline)
if [ "$nrequired" = 1 ] || [ -n "$nip" ]; then
    nmask=$(sed -n 's/.*virtnet_mask=\([^ ]*\).*/\1/p' /proc/cmdline)
    ngw=$(sed -n 's/.*virtnet_gw=\([^ ]*\).*/\1/p' /proc/cmdline)
    nprefix=$(sed -n 's/.*virtnet_prefix=\([^ ]*\).*/\1/p' /proc/cmdline)
    nmac=$(sed -n 's/.*virtnet_mac=\([^ ]*\).*/\1/p' /proc/cmdline | tr 'A-F' 'a-f' | tr -d ':' | tr -d '-')
    nmtu=$(sed -n 's/.*virtnet_mtu=\([^ ]*\).*/\1/p' /proc/cmdline)
    nroutes=$(sed -n 's/.*virtnet_routes=\([^ ]*\).*/\1/p' /proc/cmdline)
    ndns=$(sed -n 's/.*virtnet_dns=\([^ ]*\).*/\1/p' /proc/cmdline)
    nsearch=$(sed -n 's/.*virtnet_search=\([^ ]*\).*/\1/p' /proc/cmdline)
    virtnet_ok=1
    virtnet_error() {
        virtnet_ok=0
        if [ "$nrequired" = 1 ]; then
            echo "VIRTNET-FAIL: $*" >&2
            sync 2>/dev/null
            reboot -f 2>/dev/null
            exit 1
        fi
        echo "virtnet: $*" >&2
    }

    [ -n "$nip" ] || virtnet_error "missing virtnet_ip"
    ndev=
    candidate_mac=
    tries=0
    while [ "$tries" -lt 600 ] && [ -z "$ndev" ]; do
        for npath in /sys/class/net/*; do
            [ -e "$npath" ] || continue
            candidate=${npath##*/}
            [ "$candidate" = lo ] && continue
            candidate_mac=$(cat "$npath/address" 2>/dev/null | tr 'A-F' 'a-f' | tr -d ':' | tr -d '-')
            ndev=$candidate
            break
        done
        [ -n "$ndev" ] || sleep 0.05
        tries=$((tries + 1))
    done
    if [ -z "$ndev" ]; then
        observed=$(for npath in /sys/class/net/*; do [ -e "$npath" ] && printf '%s=%s ' "${npath##*/}" "$(cat "$npath/address" 2>/dev/null)"; done)
        if [ "$nrequired" = 1 ]; then
            fatal "virtnet: no non-loopback interface appeared (expected MAC ${nmac:-any}; observed ${observed:-none})"
        fi
        virtnet_error "no network interface found after 30s"
    else
        if [ "$nrequired" = 1 ] && [ -z "$nmac" ]; then
            virtnet_error "missing virtnet_mac"
        elif [ -n "$nmac" ] && [ "$candidate_mac" != "$nmac" ]; then
            configured_mac=$(echo "$nmac" | sed 's/../&:/g; s/:$//')
            if ! ifconfig "$ndev" down || ! ifconfig "$ndev" hw ether "$configured_mac"; then
                virtnet_error "failed to set $ndev MAC to $configured_mac"
            fi
        fi
        if [ "$nrequired" = 1 ] && [ -z "$nmtu" ]; then
            virtnet_error "missing virtnet_mtu"
        elif [ -n "$nmtu" ]; then
            if ! ifconfig "$ndev" mtu "$nmtu"; then
                virtnet_error "failed to set $ndev MTU to $nmtu"
            fi
        fi
        if [ "$nrequired" = 1 ] && [ -z "$nprefix" ]; then
            virtnet_error "missing virtnet_prefix"
        fi
        if [ -z "$nmask" ]; then
            if [ "$nrequired" = 1 ]; then
                virtnet_error "missing virtnet_mask"
            else
                nmask=255.255.255.0
            fi
        fi
        if ! ifconfig "$ndev" "$nip" netmask "$nmask" up; then
            virtnet_error "failed to configure $ndev as $nip/$nmask"
        fi
        if [ "$nrequired" != 1 ] && [ -n "$ngw" ]; then
            route del default dev "$ndev" 2>/dev/null
            route add -host "$ngw" dev "$ndev" 2>/dev/null
            if ! route add default gw "$ngw" dev "$ndev"; then
                virtnet_error "failed to install standalone default route via $ngw"
            fi
        fi

        oldifs=$IFS
        IFS=,
        for route in $nroutes; do
            case "$route" in
                *@*)
                    dest=${route%%@*}
                    hop=${route#*@}
                    ;;
                *)
                    virtnet_error "invalid route token $route"
                    continue
                    ;;
            esac
            if [ -z "$dest" ]; then
                virtnet_error "route has an empty destination"
                continue
            fi
            if [ -n "$hop" ]; then
                route del -host "$hop" dev "$ndev" 2>/dev/null
                if ! route add -host "$hop" dev "$ndev"; then
                    virtnet_error "failed to mark route next hop $hop on-link via $ndev"
                elif [ "$dest" = "0.0.0.0/0" ]; then
                    route del default dev "$ndev" 2>/dev/null
                    if ! route add default gw "$hop" dev "$ndev"; then
                        virtnet_error "failed to install route $dest via $hop dev $ndev"
                    fi
                else
                    route del -net "$dest" dev "$ndev" 2>/dev/null
                    if ! route add -net "$dest" gw "$hop" dev "$ndev"; then
                        virtnet_error "failed to install route $dest via $hop dev $ndev"
                    fi
                fi
            else
                route del -net "$dest" dev "$ndev" 2>/dev/null
                if ! route add -net "$dest" dev "$ndev"; then
                    virtnet_error "failed to install on-link route $dest dev $ndev"
                fi
            fi
        done
        IFS=$oldifs

        if [ "$nrequired" = 1 ] || [ -n "$ndns" ] || [ -n "$nsearch" ]; then
            if ! : > /etc/resolv.conf; then
                virtnet_error "failed to replace /etc/resolv.conf"
            fi
            oldifs=$IFS
            IFS=,
            for server in $ndns; do
                if [ -n "$server" ]; then
                    if ! printf 'nameserver %s\n' "$server" >> /etc/resolv.conf; then
                        virtnet_error "failed to write DNS server $server"
                    fi
                fi
            done
            IFS=$oldifs
            if [ -n "$nsearch" ]; then
                search_domains=$(printf '%s' "$nsearch" | tr ',' ' ')
                if ! printf 'search %s\n' "$search_domains" >> /etc/resolv.conf; then
                    virtnet_error "failed to write DNS search domains"
                fi
            fi
        fi

        nprobe=$(sed -n 's/.*virtnet_probe=\([^ ]*\).*/\1/p' /proc/cmdline)
        if [ -n "$nprobe" ]; then
            if ping -c 1 -W 1 "$nprobe" >/tmp/virtnet-probe.log 2>&1; then
                echo "VIRTNET-PROBE-OK: $nprobe"
            else
                cat /tmp/virtnet-probe.log >&2
                echo "VIRTNET-PROBE-FAIL: $nprobe" >&2
                [ "$nrequired" != 1 ] || virtnet_error "connectivity probe failed for $nprobe"
            fi
        fi
        if [ "$virtnet_ok" = 1 ]; then
            echo "VIRTNET-OK: configured $ndev as $nip/${nprefix:-$nmask} (mtu ${nmtu:-default})"
        fi
    fi
fi
# snapshot-before-exec: capture after core/network initialization but before reading dynamic
# workload data from virt-fs. Restore resumes at the next line with a fresh host mapping.
if [ "$nvx_snapshot_before_exec" = 1 ]; then
    /sbin/nvx-snapshot
    mount_virtfs
fi
# run-once: execute a mounted shell script and report its status through the VMM control port.
nvx_exec=$(sed -n 's/.*nvx_exec=\([^ ]*\).*/\1/p' /proc/cmdline)
if [ -n "$nvx_exec" ]; then
    printf 'NVX-EXEC-START'
    if [ ! -f "$nvx_exec" ]; then
        echo "nvx: executable script not found: $nvx_exec" >&2
        /sbin/nvx-exit 127
    fi
    /bin/sh "$nvx_exec"
    nvx_status=$?
    /bin/busybox sync
    /sbin/nvx-exit "$nvx_status"
    echo "nvx: failed to stop VM after workload exit" >&2
    /bin/busybox reboot -f
    exit "$nvx_status"
fi
# netsnap: optional snapshot self-test/benchmark for --net (see `scripts/nvx.py bench-net-snapshot`).
# When the kernel command line contains "netsnap", check the link, then ask the VMM to take a
# snapshot through /sbin/nvx-snapshot. On the snapshot run the VMM captures here
# and exits; on a later restore, execution resumes at the next line -- so the guest re-checks the
# link (now over the freshly rebuilt backend) and prints a marker the benchmark greps for.
#
# The check is a single sysfs read of the NIC's carrier, deliberately lighter than fork/exec-ing
# `ping`: the benchmark only needs to confirm the link resumed, and the ~60 ms of ping process
# startup would otherwise dominate the restore-to-marker time (round-trips over the link are
# sub-millisecond). The `link_up` function is defined before the snapshot point, so it is part of
# the captured shell state and is still available when execution resumes on restore.
case " $(cat /proc/cmdline) " in
    *" netsnap "*)
        linkdev="${ndev:-eth0}"
        link_up() { read -r c 2>/dev/null < "/sys/class/net/$linkdev/carrier" && [ "$c" = 1 ]; }
        link_up && echo "netsnap: pre-snapshot link OK" || echo "netsnap: pre-snapshot link FAIL"
        ntcp=$(sed -n 's/.*netsnap_tcp=\([^ ]*\).*/\1/p' /proc/cmdline)
        if [ -n "$ntcp" ]; then
            nthost=${ntcp%:*}
            ntport=${ntcp##*:}
            rm -f /tmp/netsnap-tcp.in /tmp/netsnap-tcp.out
            : > /tmp/netsnap-tcp.in
            follow_tcp_input() {
                next_line=1
                while :; do
                    line=$(sed -n "${next_line}p" /tmp/netsnap-tcp.in)
                    if [ -n "$line" ]; then
                        printf '%s\n' "$line"
                        next_line=$((next_line + 1))
                    else
                        sleep 0.05
                    fi
                done
            }
            follow_tcp_input |
                nc "$nthost" "$ntport" >/tmp/netsnap-tcp.out 2>&1 &
            ncpid=$!
            wait_for_tcp_ack() {
                marker=$1
                attempts=0
                while [ "$attempts" -lt 5 ]; do
                    grep -q "^ACK:$marker$" /tmp/netsnap-tcp.out && return 0
                    kill -0 "$ncpid" 2>/dev/null || return 1
                    attempts=$((attempts + 1))
                    sleep 1
                done
                return 1
            }
            echo PRE >> /tmp/netsnap-tcp.in
            if wait_for_tcp_ack PRE; then
                echo "netsnap: pre-snapshot TCP OK ($ntcp)"
            else
                echo "netsnap: pre-snapshot TCP FAIL ($ntcp)" >&2
            fi
        fi
        ntxflood=$(sed -n 's/.*netsnap_tx_flood=\([^ ]*\).*/\1/p' /proc/cmdline)
        if [ -n "$ntxflood" ]; then
            ping -i 0.01 "$ntxflood" >/tmp/netsnap-tx-flood.log 2>&1 &
            ntxpid=$!
            sleep 1
            if kill -0 "$ntxpid" 2>/dev/null; then
                echo "netsnap: active TX flood running ($ntxflood)"
            else
                cat /tmp/netsnap-tx-flood.log >&2
                echo "netsnap: active TX flood failed ($ntxflood)" >&2
                ntxpid=
            fi
        fi
        /sbin/nvx-snapshot
        # ---- on restore, execution resumes here ----
        if link_up; then
            if [ -n "$nprobe" ]; then
                if ping -c 1 -W 1 "$nprobe" >/tmp/netsnap-restore-probe.log 2>&1; then
                    echo "NETSNAP-RESTORE-PROBE-OK: $nprobe"
                    echo "NETSNAP-RESTORE-OK"
                else
                    cat /tmp/netsnap-restore-probe.log >&2
                    echo "NETSNAP-RESTORE-PROBE-FAIL: $nprobe" >&2
                    echo "NETSNAP-RESTORE-FAIL"
                fi
            else
                echo "NETSNAP-RESTORE-OK"
            fi
        else
            echo "NETSNAP-RESTORE-FAIL"
        fi
        if [ -n "$ntxpid" ]; then
            kill "$ntxpid" 2>/dev/null
            wait "$ntxpid" 2>/dev/null
            echo "NETSNAP-ACTIVE-TX-RESTORE-OK: $ntxflood"
        fi
        if [ -n "$ntcp" ]; then
            echo POST >> /tmp/netsnap-tcp.in
            if wait_for_tcp_ack POST; then
                echo "NETSNAP-TCP-RESTORE-OK: $ntcp"
            else
                cat /tmp/netsnap-tcp.out >&2
                echo "NETSNAP-TCP-RESTORE-FAIL: $ntcp" >&2
            fi
            wait "$ncpid" 2>/dev/null
        fi
        ;;
esac
# shellsnap: optional cold-vs-snapshot benchmark for the plain shell (see
# `scripts/nvx.py bench-snapshot-shell`). When the kernel command line contains "shellsnap", ask the VMM
# to take a snapshot through /sbin/nvx-snapshot just before the boot banner below.
# On the snapshot run the VMM captures here and exits; on a later restore, execution resumes at the
# next line and falls through to the banner -- the same marker the benchmark times on a cold boot.
# On a plain cold boot (no --snapshot) the VMM ignores the write, so this stays a no-op.
case " $(cat /proc/cmdline) " in
    *" shellsnap "*)
        /sbin/nvx-snapshot
        # ---- on restore, execution resumes here ----
        ;;
esac
echo
echo "=========================================="
echo " ALPINE-MICROVM-BOOT-OK: $(cat /etc/alpine-release 2>/dev/null)"
echo " uname: $(uname -a)"
echo "=========================================="
echo
# snap: optional snapshot benchmark for a plain (non-networked) shell (see the shell-snapshot
# benchmark). When the kernel command line contains "snap", ask the VMM to take a snapshot at
# this fully-booted, shell-ready point through /sbin/nvx-snapshot. On the
# snapshot run the VMM captures here and exits; on a later restore, execution resumes at the next
# line and the guest prints a marker the benchmark greps for before dropping to the shell.
case " $(cat /proc/cmdline) " in
    *" snap "*)
        /sbin/nvx-snapshot
        # ---- on restore, execution resumes here ----
        echo "SNAP-RESTORE-OK"
        ;;
esac
exec /bin/sh
