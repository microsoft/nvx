#!/bin/sh
# PID 1 for the RAM initramfs. Mounts the pseudo-filesystems, prints a recognizable
# boot-completion banner (used as the cold-start marker), and drops to an interactive shell.
mount -t proc none /proc
mount -t sysfs none /sys
mount -t devtmpfs none /dev 2>/dev/null || mdev -s
mount -t tmpfs none /tmp
# virt-fs: if the VMM exported a host directory (see --mount), the kernel's phram/mtdblock
# driver surfaces it as /dev/mtdblock0. Mount it at the requested point using the filesystem type
# and access mode the VMM chose (all passed on the kernel command line: "virtfs_dir=<path>",
# "virtfs_fs=<type>", "virtfs_mode=<ro|rw>"; defaults: /mnt/host, squashfs, ro).
if [ -e /dev/mtdblock0 ]; then
    vdir=$(sed -n 's/.*virtfs_dir=\([^ ]*\).*/\1/p' /proc/cmdline)
    [ -n "$vdir" ] || vdir=/mnt/host
    vfs=$(sed -n 's/.*virtfs_fs=\([^ ]*\).*/\1/p' /proc/cmdline)
    [ -n "$vfs" ] || vfs=squashfs
    vmode=$(sed -n 's/.*virtfs_mode=\([^ ]*\).*/\1/p' /proc/cmdline)
    [ -n "$vmode" ] || vmode=ro
    mkdir -p "$vdir"
    if mount -t "$vfs" -o "$vmode" /dev/mtdblock0 "$vdir" 2>/dev/null; then
        echo "virtfs: mounted host directory at $vdir ($vfs,$vmode)"
    else
        echo "virtfs: failed to mount /dev/mtdblock0 at $vdir" >&2
    fi
fi
# virt-net: if the VMM attached a NIC (see --net or --net-config), the virtio-net driver surfaces it as the only
# non-loopback interface. Configure it from the kernel command line tokens the VMM appended
# ("virtnet_ip=<ip>", "virtnet_mask=<dotted>", "virtnet_gw=<host>"): assign the address with
# ifconfig (busybox's ip-addr resolves the device via AF_UNIX, which this minimal kernel omits),
# then route the default gateway at the host side of the point-to-point link.
nip=$(sed -n 's/.*virtnet_ip=\([^ ]*\).*/\1/p' /proc/cmdline)
if [ -n "$nip" ]; then
    nmask=$(sed -n 's/.*virtnet_mask=\([^ ]*\).*/\1/p' /proc/cmdline)
    ngw=$(sed -n 's/.*virtnet_gw=\([^ ]*\).*/\1/p' /proc/cmdline)
    nprefix=$(sed -n 's/.*virtnet_prefix=\([^ ]*\).*/\1/p' /proc/cmdline)
    nmac=$(sed -n 's/.*virtnet_mac=\([^ ]*\).*/\1/p' /proc/cmdline)
    nmtu=$(sed -n 's/.*virtnet_mtu=\([^ ]*\).*/\1/p' /proc/cmdline)
    nroutes=$(sed -n 's/.*virtnet_routes=\([^ ]*\).*/\1/p' /proc/cmdline)
    ndns=$(sed -n 's/.*virtnet_dns=\([^ ]*\).*/\1/p' /proc/cmdline)
    nsearch=$(sed -n 's/.*virtnet_search=\([^ ]*\).*/\1/p' /proc/cmdline)
    ndev=$(ls /sys/class/net 2>/dev/null | grep -v '^lo$' | head -n1)
    if [ -n "$ndev" ]; then
        [ -n "$nmac" ] && ifconfig "$ndev" hw ether "$nmac" 2>/dev/null
        [ -n "$nmtu" ] && ifconfig "$ndev" mtu "$nmtu" 2>/dev/null
        ifconfig "$ndev" "$nip" netmask "${nmask:-255.255.255.0}" up
        [ -n "$ngw" ] && ip route add default via "$ngw" 2>/dev/null
        oldifs=$IFS
        IFS=,
        for route in $nroutes; do
            dest=${route%@*}
            hop=${route#*@}
            [ -n "$dest" ] && [ "$dest" != "$route" ] && ip route add "$dest" via "$hop" 2>/dev/null
        done
        for server in $ndns; do
            [ -n "$server" ] && echo "nameserver $server" >> /etc/resolv.conf
        done
        IFS=$oldifs
        [ -n "$nsearch" ] && echo "search $(echo "$nsearch" | tr ',' ' ')" >> /etc/resolv.conf
        echo "virtnet: configured $ndev as $nip/${nprefix:-$nmask} (gw ${ngw:-none}, mtu ${nmtu:-default})"
        nprobe=$(sed -n 's/.*virtnet_probe=\([^ ]*\).*/\1/p' /proc/cmdline)
        if [ -n "$nprobe" ]; then
            if ping -c 3 -W 2 "$nprobe" >/tmp/virtnet-probe.log 2>&1; then
                echo "VIRTNET-PROBE-OK: $nprobe"
            else
                cat /tmp/virtnet-probe.log >&2
                echo "VIRTNET-PROBE-FAIL: $nprobe" >&2
            fi
        fi
    else
        echo "virtnet: no network interface found" >&2
    fi
fi
# netsnap: optional snapshot self-test/benchmark for --net (see `scripts/nvx.py bench-net-snapshot`).
# When the kernel command line contains "netsnap", check the link, then ask the VMM to take a
# snapshot (one outb to I/O port 0x605 via /dev/port). On the snapshot run the VMM captures here
# and exits; on a later restore, execution resumes at the next line -- so the guest re-checks the
# link (now over the freshly rebuilt backend) and prints a marker the benchmark greps for.
#
# The check is a single sysfs read of the NIC's carrier, deliberately lighter than fork/exec-ing
# `ping`: the benchmark only needs to confirm the link resumed, and the ~60 ms of ping process
# startup would otherwise dominate the restore-to-marker time (round-trips over the link are
# sub-millisecond). The `link_up` function is defined before the snapshot point, so it is part of
# the captured shell state and is still available when execution resumes on restore.
case " $(cat /proc/cmdline) " in
    *" netsnap "*)
        linkdev="${ndev:-eth0}"
        link_up() { read -r c 2>/dev/null < "/sys/class/net/$linkdev/carrier" && [ "$c" = 1 ]; }
        link_up && echo "netsnap: pre-snapshot link OK" || echo "netsnap: pre-snapshot link FAIL"
        ntcp=$(sed -n 's/.*netsnap_tcp=\([^ ]*\).*/\1/p' /proc/cmdline)
        if [ -n "$ntcp" ]; then
            nthost=${ntcp%:*}
            ntport=${ntcp##*:}
            rm -f /tmp/netsnap-tcp.in /tmp/netsnap-tcp.out
            mkfifo /tmp/netsnap-tcp.in
            nc "$nthost" "$ntport" </tmp/netsnap-tcp.in >/tmp/netsnap-tcp.out 2>&1 &
            ncpid=$!
            exec 3>/tmp/netsnap-tcp.in
            wait_for_tcp_ack() {
                marker=$1
                attempts=0
                while [ "$attempts" -lt 5 ]; do
                    grep -q "^ACK:$marker$" /tmp/netsnap-tcp.out && return 0
                    kill -0 "$ncpid" 2>/dev/null || return 1
                    attempts=$((attempts + 1))
                    sleep 1
                done
                return 1
            }
            echo PRE >&3
            if wait_for_tcp_ack PRE; then
                echo "netsnap: pre-snapshot TCP OK ($ntcp)"
            else
                echo "netsnap: pre-snapshot TCP FAIL ($ntcp)" >&2
            fi
        fi
        printf '\001' | dd of=/dev/port bs=1 seek=1541 count=1 conv=notrunc 2>/dev/null
        # ---- on restore, execution resumes here ----
        if link_up; then
            echo "NETSNAP-RESTORE-OK"
        else
            echo "NETSNAP-RESTORE-FAIL"
        fi
        if [ -n "$ntcp" ]; then
            echo POST >&3
            if wait_for_tcp_ack POST; then
                echo "NETSNAP-TCP-RESTORE-OK: $ntcp"
            else
                cat /tmp/netsnap-tcp.out >&2
                echo "NETSNAP-TCP-RESTORE-FAIL: $ntcp" >&2
            fi
            exec 3>&-
            wait "$ncpid" 2>/dev/null
        fi
        ;;
esac
# shellsnap: optional cold-vs-snapshot benchmark for the plain shell (see
# `scripts/nvx.py bench-snapshot-shell`). When the kernel command line contains "shellsnap", ask the VMM
# to take a snapshot (one outb to I/O port 0x605 via /dev/port) just before the boot banner below.
# On the snapshot run the VMM captures here and exits; on a later restore, execution resumes at the
# next line and falls through to the banner -- the same marker the benchmark times on a cold boot.
# On a plain cold boot (no --snapshot) the VMM ignores the write, so this stays a no-op.
case " $(cat /proc/cmdline) " in
    *" shellsnap "*)
        printf '\001' | dd of=/dev/port bs=1 seek=1541 count=1 conv=notrunc 2>/dev/null
        # ---- on restore, execution resumes here ----
        ;;
esac
echo
echo "=========================================="
echo " ALPINE-MICROVM-BOOT-OK: $(cat /etc/alpine-release 2>/dev/null)"
echo " uname: $(uname -a)"
echo "=========================================="
echo
export PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME=/root TERM=linux
# snap: optional snapshot benchmark for a plain (non-networked) shell (see the shell-snapshot
# benchmark). When the kernel command line contains "snap", ask the VMM to take a snapshot at
# this fully-booted, shell-ready point (one outb to I/O port 0x605 via /dev/port). On the
# snapshot run the VMM captures here and exits; on a later restore, execution resumes at the next
# line and the guest prints a marker the benchmark greps for before dropping to the shell.
case " $(cat /proc/cmdline) " in
    *" snap "*)
        printf '\001' | dd of=/dev/port bs=1 seek=1541 count=1 conv=notrunc 2>/dev/null
        # ---- on restore, execution resumes here ----
        echo "SNAP-RESTORE-OK"
        ;;
esac
exec /bin/sh
